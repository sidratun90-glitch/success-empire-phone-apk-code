rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'parwejhayat3@gmail.com';
    }

    // --- PUBLIC READ / ADMIN WRITE COLLECTIONS ---
    
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{app} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      // Allow authenticated users to update coupon counts when using them
      allow update: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- SECURED / USER / ADMIN COLLECTIONS ---

    match /users/{userId} {
      // Users can read/write their own data; Admin has full access
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    match /purchase_records/{recordId} {
      // Users can read their own purchase records by matching email; Admin has full access
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == resource.data.email);
      allow write: if isAdmin();
    }
    
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }

    match /recovery_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
