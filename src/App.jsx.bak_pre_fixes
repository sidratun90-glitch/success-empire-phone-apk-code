    setSingleUserQuerying(true);
    setSingleUserResult(null);
    setSingleUserDryRun(null);
    try {
      // 1. Try to find user in users collection
      let liveUser = null;
      let uid = "";
      let email = "";

      // Query by UID
      const uidRef = doc(db, "users", qStr);
      const uidSnap = await getDoc(uidRef);
      if (uidSnap.exists()) {
        liveUser = uidSnap.data();
        uid = uidSnap.id;
        email = liveUser.email || "";
      } else {
        // Query by Email
        const emailQuery = query(collection(db, "users"), where("email", "==", qStr));
        const emailSnap = await getDocs(emailQuery);
        if (!emailSnap.empty) {
          const userDoc = emailSnap.docs[0];
          liveUser = userDoc.data();
          uid = userDoc.id;
          email = liveUser.email || "";
        }
      }

      // 2. Fetch all backup records in purchase_records matching this email/UID
      const recordsSnap = await getDocs(collection(db, "purchase_records"));
