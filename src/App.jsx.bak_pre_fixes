        }
        if (certificates && Array.isArray(certificates)) {
          for (const c of certificates) {
            await setDoc(doc(db, "certificates", c.id || c.uid), c);
          }
        }
        if (recovery_logs && Array.isArray(recovery_logs)) {
          for (const l of recovery_logs) {
            await setDoc(doc(db, "recovery_logs", l.id || `${l.timestamp}`), l);
          }
        }
        if (notifications && Array.isArray(notifications)) {
          for (const n of notifications) {
            await setDoc(doc(db, "notifications", n.id ? n.id.toString() : `notif_${Date.now()}_${Math.random()}`), n);
