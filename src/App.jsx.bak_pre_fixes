              grantedAccessType: u.grantedAccessType || "",
              grantedAccessPrivateNotes: u.grantedAccessPrivateNotes || ""
            };
            await updateDoc(userRef, mergedAccess);
          } else {
            await setDoc(userRef, u);
          }
        }
      }

      try {
        const performedByEmail = auth.currentUser ? auth.currentUser.email : "admin@system.com";
        await addDoc(collection(db, "recovery_logs"), {
          actionType: "DATABASE_RESTORE",
          performedBy: performedByEmail,
          actionDate: Date.now(),
          notes: `Database restored in ${mode.toUpperCase()} mode from backup created at ${new Date(backupData.backupMeta?.createdAt || Date.now()).toLocaleString()}.`
        });
      } catch (logErr) {
        console.error("Failed to write recovery log for restore:", logErr);
      }

      showToast(`Database restored successfully! (${mode.toUpperCase()} MODE) 🎉`);
      return { success: true, report };
