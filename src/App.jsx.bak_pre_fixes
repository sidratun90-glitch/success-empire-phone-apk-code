        return { type: 'iframe', platform: 'vimeo', url: embedUrl };
      }
    }

    // Facebook
    if (url.includes('facebook.com/')) {
      return { type: 'iframe', platform: 'facebook', url: `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=0` };
    }

    // Direct Video files (mp4, webm, ogg, mov, m4v) or Firebase Storage
    const isDirectVideo = url.match(/\.(mp4|webm|ogg|mov|m4v)($|\?)/i) ||
      url.includes('firebasestorage.googleapis.com') ||
      url.startsWith('blob:') ||
      url.includes('drive.google.com') ||
      url.includes('dropbox.com');

    if (isDirectVideo || url.includes('/video/')) {
      return { type: 'direct', url: url, platform: 'direct' };
    }

    return { type: 'direct_fallback', url: url, platform: 'direct' };
  };

