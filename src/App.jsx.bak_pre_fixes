const FullscreenReviewPlayer = ({ item, onClose }) => {
  const [isPlaying, setIsPlaying] = React.useState(true);
  const [currentTime, setCurrentTime] = React.useState(0);
  const [duration, setDuration] = React.useState(0);
  const [playbackRate, setPlaybackRate] = React.useState(1);
  const [showSpeedMenu, setShowSpeedMenu] = React.useState(false);
  const videoRef = React.useRef(null);
  const seekTrackRef = React.useRef(null);
  const isDraggingSeekRef = React.useRef(false);

  // Synchronize playing state and auto-detect browser playback blocks
  React.useEffect(() => {
    if (videoRef.current) {
      if (isPlaying) {
        videoRef.current.play().catch(err => {
          console.warn("Video playback blocked or failed:", err);
          setIsPlaying(false);
        });
      } else {
        videoRef.current.pause();
      }
    }
  }, [isPlaying]);

  const handleClose = () => {
    onClose();
  };

  const handlePlayToggle = (e) => {
    e.stopPropagation();
    setIsPlaying(prev => !prev);
  };

  const handleTimeUpdate = () => {
    if (videoRef.current) {
      setCurrentTime(videoRef.current.currentTime);
    }
  };

  const handleLoadedMetadata = () => {
    if (videoRef.current) {
      setDuration(videoRef.current.duration);
    }
  };

  const handleSeekStart = (e) => {
    e.stopPropagation();
    isDraggingSeekRef.current = true;

    const track = seekTrackRef.current;
    if (!track) return;

    const updatePosition = (evt) => {
      if (!videoRef.current || duration <= 0) return;
      const rect = track.getBoundingClientRect();
      const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
      const offsetX = Math.max(0, Math.min(clientX - rect.left, rect.width));
      const percentage = offsetX / rect.width;
      const newTime = percentage * duration;

      videoRef.current.currentTime = newTime;
      setCurrentTime(newTime);
    };

    updatePosition(e);

    const handleMouseMove = (moveEvent) => {
      updatePosition(moveEvent);
    };

    const handleMouseUp = () => {
      isDraggingSeekRef.current = false;
      document.removeEventListener('mousemove', handleMouseMove);
      document.removeEventListener('mouseup', handleMouseUp);
      document.removeEventListener('touchmove', handleMouseMove);
      document.removeEventListener('touchend', handleMouseUp);
    };

    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
    document.addEventListener('touchmove', handleMouseMove, { passive: true });
    document.addEventListener('touchend', handleMouseUp);
  };

  const changeSpeed = (speed, e) => {
    e.stopPropagation();
    setPlaybackRate(speed);
    setShowSpeedMenu(false);
    if (videoRef.current) {
      videoRef.current.playbackRate = speed;
    }
  };

  const formatTime = (secs) => {
    const m = Math.floor(secs / 60).toString().padStart(2, '0');
    const s = Math.floor(secs % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  };

  // Determine Video URL Type using regex
  let youtubeId = null;
  const url = item.videoUrl || "";
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|shorts\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  if (match && match[2].length === 11) {
    youtubeId = match[2];
  }

  const isYouTube = !!youtubeId;

  return (
    <div
      className="fixed inset-0 z-[9999] flex items-center justify-center pointer-events-auto bg-black/80"
      onClick={handleClose}
    >
      <div
        className="relative w-[70%] max-w-[280px] aspect-[9/16] bg-black rounded-3xl overflow-hidden border border-white/20 shadow-[0_0_50px_rgba(0,0,0,0.8)] flex flex-col justify-between"
        onClick={(e) => e.stopPropagation()}
        style={{ transformOrigin: 'center center' }}
      >
        {/* Active playing video frame */}
        <div className="w-full h-full bg-black relative flex-1">
          {isYouTube ? (
            <iframe
              src={`https://www.youtube.com/embed/${youtubeId}?autoplay=1&controls=1&rel=0&modestbranding=1`}
              title="Success Review Video"
              className="w-full h-full border-0"
              allow="autoplay; fullscreen"
              allowFullScreen
            />
          ) : (
            <video
              ref={videoRef}
              src={url}
              autoPlay
              playsInline
              onTimeUpdate={handleTimeUpdate}
              onLoadedMetadata={handleLoadedMetadata}
              onEnded={() => setIsPlaying(false)}
              className="w-full h-full object-cover"
              onClick={handlePlayToggle}
            />
          )}
        </div>

        {/* Floating Close Button */}
        <button
          type="button"
          onClick={handleClose}
          className="absolute top-4 left-4 w-9 h-9 rounded-full bg-black/60 backdrop-blur-md border border-white/10 flex items-center justify-center text-white hover:bg-black/80 active:scale-90 transition-all z-50 cursor-pointer"
        >
          <ChevronLeft size={20} />
        </button>



        {/* Play Button Overlay (when direct video paused) */}
        {!isYouTube && !isPlaying && (
          <div
            onClick={handlePlayToggle}
            className="absolute inset-0 flex items-center justify-center z-30 cursor-pointer"
          >
            <button
              type="button"
              className="w-16 h-16 rounded-full bg-yellow-500 flex items-center justify-center text-white border-4 border-white shadow-2xl active:scale-95 transition-transform"
            >
              <Play size={24} className="fill-white text-white ml-1" />
            </button>
          </div>
        )}

        {/* Control overlay at the bottom for direct videos */}
        {!isYouTube && (
          <div className="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black via-black/80 to-transparent flex flex-col gap-2 z-40">

            {/* Custom Time & Control Buttons row */}
            <div className="flex items-center justify-between text-white text-[10px] font-bold">
              {/* Elapsed Time */}
              <span>{formatTime(currentTime)} / {formatTime(duration)}</span>

              {/* Right side buttons */}
              <div className="flex items-center gap-3 relative">
                {/* Play/Pause toggle */}
                <button
                  type="button"
                  onClick={handlePlayToggle}
                  className="hover:text-yellow-400 transition-colors cursor-pointer"
                >
                  {isPlaying ? <Pause size={14} /> : <Play size={14} />}
                </button>

                {/* Settings Gear */}
                <button
                  type="button"
                  onClick={(e) => {
                    e.stopPropagation();
                    setShowSpeedMenu(!showSpeedMenu);
                  }}
                  className="hover:text-yellow-400 transition-colors cursor-pointer"
                >
                  <Settings size={13} />
                </button>

                {/* Speed Settings Menu */}
                {showSpeedMenu && (
                  <div className="absolute bottom-6 right-0 bg-black/95 border border-white/20 rounded-xl p-1.5 flex flex-col gap-1 z-50 min-w-[70px] shadow-2xl">
                    {[1, 1.25, 1.5, 2].map((speed) => (
                      <button
                        key={speed}
                        type="button"
                        onClick={(e) => changeSpeed(speed, e)}
                        className={`text-[9px] px-2 py-1 rounded-md text-left hover:bg-white/10 ${playbackRate === speed ? "text-yellow-400 font-bold" : "text-white"}`}
                      >
                        {speed}x
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>

            {/* Custom Progress Track Bar with dragging */}
            <div
              ref={seekTrackRef}
              onMouseDown={handleSeekStart}
              onTouchStart={handleSeekStart}
              className="w-full py-2 cursor-pointer relative select-none"
            >
              <div className="w-full h-1.5 bg-white/20 rounded-full overflow-hidden">
                <div
                  className="h-full bg-yellow-500 rounded-full"
                  style={{ width: `${duration > 0 ? (currentTime / duration) * 100 : 0}%` }}
                />
              </div>
              {/* Seeking Thumb handle */}
              <div
                className="absolute top-1/2 -translate-y-1/2 w-3.5 h-3.5 bg-white rounded-full border-2 border-yellow-500 shadow-md pointer-events-none transition-transform hover:scale-120"
                style={{ left: `calc(${duration > 0 ? (currentTime / duration) * 100 : 0}% - 7px)` }}
              />
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

