  const parseVimeoUrl = (url) => {
    if (!url || !url.includes('vimeo.com')) return null;
    try {
      let videoId = "";
      let hash = "";

      // Extract query parameter h if present
      const urlObj = new URL(url.startsWith('http') ? url : `https://${url}`);
      hash = urlObj.searchParams.get('h') || "";

      const path = urlObj.pathname;
      const pathParts = path.split('/').filter(Boolean);

      // Check if format is vimeo.com/123456789/abcdef123 (private video)
      if (pathParts.length >= 2 && /^\d+$/.test(pathParts[0]) && /^[a-z0-9]+$/i.test(pathParts[1])) {
        videoId = pathParts[0];
        hash = pathParts[1];
      } else {
        // Find the first part that is purely numeric
        const numericIndex = pathParts.findIndex(part => /^\d+$/.test(part));
        if (numericIndex !== -1) {
          videoId = pathParts[numericIndex];
          // If the next part is alphanumeric, check if it's the hash
          if (numericIndex + 1 < pathParts.length && /^[a-z0-9]+$/i.test(pathParts[numericIndex + 1])) {
            hash = pathParts[numericIndex + 1];
          }
        }
      }

      if (!videoId) {
        const match = url.match(/\/(\d+)/);
        if (match) {
          videoId = match[1];
        }
      }

      return { videoId, hash };
    } catch (e) {
      console.warn("Failed to parse Vimeo URL:", e);
      const match = url.match(/\/(\d+)/);
      return match ? { videoId: match[1], hash: "" } : null;
    }
  };

  const getEmbedInfo = (url, selectedQuality) => {
    if (!url) return { type: 'none', url: null, platform: null };

    // Map quality to YouTube vq parameter
    let vqParam = "";
    if (selectedQuality === "1080p") vqParam = "&vq=hd1080";
    else if (selectedQuality === "720p") vqParam = "&vq=hd720";
    else if (selectedQuality === "480p") vqParam = "&vq=large";
    else if (selectedQuality === "360p") vqParam = "&vq=medium";
    else if (selectedQuality === "240p") vqParam = "&vq=small";
    else if (selectedQuality === "144p") vqParam = "&vq=tiny";

    const ccParam = `&cc_load_policy=${captionLanguage === 'on' ? '1' : '3'}`;

    // YouTube
    const ytParams = `&iv_load_policy=3&disablekb=1&fs=0&playsinline=1&origin=${encodeURIComponent(window.location.origin)}`;

    if (url.includes('youtube.com/watch?v=')) {
      const videoId = url.split('v=')[1]?.split('&')[0];
      return { type: 'iframe', platform: 'youtube', url: `https://www.youtube.com/embed/${videoId}?autoplay=0&rel=0&enablejsapi=1&modestbranding=1&controls=0${vqParam}${ccParam}${ytParams}` };
    }
    if (url.includes('youtu.be/')) {
      const videoId = url.split('youtu.be/')[1]?.split('?')[0]?.split('&')[0];
      return { type: 'iframe', platform: 'youtube', url: `https://www.youtube.com/embed/${videoId}?autoplay=0&rel=0&enablejsapi=1&modestbranding=1&controls=0${vqParam}${ccParam}${ytParams}` };
    }
    if (url.includes('youtube.com/embed/')) {
      let embedUrl = url;
      if (embedUrl.includes('autoplay=1')) {
        embedUrl = embedUrl.replace('autoplay=1', 'autoplay=0');
      } else if (!embedUrl.includes('autoplay=')) {
        embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'autoplay=0';
      }
      if (!embedUrl.includes('enablejsapi=1')) {
        embedUrl += (embedUrl.includes('?') ? '&' : '?') + 'enablejsapi=1&modestbranding=1&controls=0';
      }
      // Replace or append vq parameter
      if (vqParam) {
        embedUrl = embedUrl.replace(/[\?&]vq=[^&]+/, "");
        embedUrl += vqParam;
      } else {
        embedUrl = embedUrl.replace(/[\?&]vq=[^&]+/, "");
      }
      // Replace or append ccParam
      embedUrl = embedUrl.replace(/[\?&]cc_load_policy=[^&]+/, "");
      embedUrl += ccParam;

      if (!embedUrl.includes('iv_load_policy=')) {
        embedUrl += ytParams;
      }
      return { type: 'iframe', platform: 'youtube', url: embedUrl };
    }
    if (url.includes('youtube.com/shorts/')) {
      const videoId = url.split('shorts/')[1]?.split('?')[0]?.split('&')[0];
      return { type: 'iframe', platform: 'youtube', url: `https://www.youtube.com/embed/${videoId}?autoplay=0&rel=0&enablejsapi=1&modestbranding=1&controls=0${vqParam}${ccParam}${ytParams}` };
    }

    // Instagram
    if (url.includes('instagram.com/')) {
      let cleanUrl = url.split('?')[0];
      if (!cleanUrl.endsWith('/')) cleanUrl += '/';
      return { type: 'iframe', platform: 'instagram', url: `${cleanUrl}embed` };
    }

    // Vimeo
    if (url.includes('vimeo.com/')) {
      const parsed = parseVimeoUrl(url);
      if (parsed && parsed.videoId) {
        let embedUrl = `https://player.vimeo.com/video/${parsed.videoId}?autoplay=0&api=1&title=0&byline=0&portrait=0&badge=0&controls=0`;
        if (parsed.hash) {
          embedUrl += `&h=${parsed.hash}`;
