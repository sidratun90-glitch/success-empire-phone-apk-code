    lastTapRef.current = { time: now, x: clickX };
  };

  const handleTouchStart = (e) => {
    if (isLocked) return;

    if (e.touches.length === 2) {
      isPinchingRef.current = true;
      const t1 = e.touches[0];
      const t2 = e.touches[1];
      const dist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
      touchStartValRef.current.scale = zoomScale;
      touchStartValRef.current.pinchDist = dist;
    } else if (e.touches.length === 1) {
      isPinchingRef.current = false;
      const touch = e.touches[0];
      touchStartRef.current = { x: touch.clientX, y: touch.clientY, time: Date.now() };

      touchStartValRef.current.volume = volume;
      touchStartValRef.current.brightness = brightness;
      isDraggingRef.current = false;
      activeGestureRef.current = null;
    }
  };

  const handleTouchMove = (e) => {
    if (isLocked) return;

    if (isPinchingRef.current && e.touches.length === 2) {
      const t1 = e.touches[0];
      const t2 = e.touches[1];
      const dist = Math.hypot(t2.clientX - t1.clientX, t2.clientY - t1.clientY);
      const startDist = touchStartValRef.current.pinchDist || 1;
      const newScale = touchStartValRef.current.scale * (dist / startDist);
      setZoomScale(Math.min(Math.max(newScale, 1.0), 3.0));
      ignoreNextClickRef.current = true;
    } else if (e.touches.length === 1 && !isPinchingRef.current) {
      const touch = e.touches[0];
      const deltaX = touch.clientX - touchStartRef.current.x;
      const deltaY = touch.clientY - touchStartRef.current.y;

      if (!isDraggingRef.current && (Math.abs(deltaX) > 15 || Math.abs(deltaY) > 15)) {
        isDraggingRef.current = true;
        // Lock gesture type and side when drag first begins
        if (Math.abs(deltaY) > Math.abs(deltaX)) {
          const rect = playerRef.current?.getBoundingClientRect();
          if (rect) {
            const startTouchX = touchStartRef.current.x - rect.left;
            if (startTouchX < rect.width / 2) {
              activeGestureRef.current = 'volume';
              if (window.AndroidOrientation && window.AndroidOrientation.getSystemVolume) {
                try {
                  const nativeVol = window.AndroidOrientation.getSystemVolume();
                  touchStartValRef.current.volume = nativeVol;
                  setVolume(nativeVol);
                } catch (err) {
                  console.warn("Failed to get system volume:", err);
                }
              }
            } else {
              activeGestureRef.current = 'brightness';
              if (window.Capacitor) {
                ScreenBrightness.getBrightness().then(({ brightness: nativeVal }) => {
                  const currentBrightVal = Math.min(Math.max(nativeVal * 80 + 20, 20), 100);
                  touchStartValRef.current.brightness = currentBrightVal;
                  setBrightness(currentBrightVal);
                }).catch(err => {
                  console.warn("Failed to get native screen brightness:", err);
                });
              }
            }
          }
        }
      }

      if (isDraggingRef.current && activeGestureRef.current) {
        ignoreNextClickRef.current = true;
        const rect = playerRef.current?.getBoundingClientRect();
        if (!rect) return;
        const playerHeight = rect.height || 300;
        const fraction = -deltaY / playerHeight;

        if (activeGestureRef.current === 'brightness') {
          const newBright = Math.min(Math.max(touchStartValRef.current.brightness + fraction * 80, 20), 100);
          setBrightness(newBright);
          setGestureIndicator({ type: 'brightness', value: Math.round(newBright) });
          
          if (window.Capacitor) {
            const nativeLevel = Math.min(Math.max((newBright - 20) / 80, 0.05), 1.0);
            ScreenBrightness.setBrightness({ brightness: nativeLevel }).catch(err => {
              console.warn("Failed to set native screen brightness:", err);
            });
          }
        }

        if (activeGestureRef.current === 'volume') {
          const newVol = Math.min(Math.max(touchStartValRef.current.volume + fraction * 1.0, 0), 1.0);
          setVolume(newVol);
          setGestureIndicator({ type: 'volume', value: Math.round(newVol * 100) });
          
          if (videoElRef.current) {
            videoElRef.current.volume = newVol;
          }
          
          if (window.AndroidOrientation && window.AndroidOrientation.setSystemVolume) {
            try {
              window.AndroidOrientation.setSystemVolume(newVol);
            } catch (err) {
              console.warn("Failed to set system volume:", err);
            }
          }
        }
      }
    }
  };

