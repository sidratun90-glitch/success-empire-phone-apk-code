      const email = targetUser.email;
      const targetUid = targetUser.id || targetUser.uid;

      if (!email || !targetUid) {
        showToast("Invalid student profile.");
        return;
      }

      const purchaseQuery = query(collection(db, "purchase_records"), where("email", "==", email));
      const purchaseSnap = await getDocs(purchaseQuery);

      const restoredPkgIds = [];
      const batchPromises = [];

      purchaseSnap.forEach((docSnap) => {
        const record = docSnap.data();
        if (record.courseId) {
          restoredPkgIds.push(record.courseId);
          if (record.uid !== targetUid) {
            const recordDocRef = doc(db, "purchase_records", docSnap.id);
            batchPromises.push(updateDoc(recordDocRef, { uid: targetUid }));
          }
        }
      });

      if (restoredPkgIds.length === 0) {
        showToast("No purchase records found for " + email);
        return;
      }

      const currentList = targetUser.purchasedPackages || [];
      const updatedList = Array.from(new Set([...currentList, ...restoredPkgIds]));

      const newCurrentPackage = getHighestActivePackage(updatedList);
      const newCurrentPkgObj = PACKAGES.find(p => p.id === newCurrentPackage);
      const newPurchaseAmount = newCurrentPkgObj ? newCurrentPkgObj.price : 0;
      let newPurchaseDate = targetUser.purchaseDate || Date.now();

      const userDocRef = doc(db, "users", targetUid);
      await setDoc(userDocRef, {
        purchasedPackages: updatedList,
        currentPackage: newCurrentPackage,
        purchaseAmount: newPurchaseAmount,
        purchaseDate: newPurchaseDate
      }, { merge: true });

      if (batchPromises.length > 0) {
        await Promise.all(batchPromises);
      }

      const performedByEmail = auth.currentUser?.email || "Admin";
      await addDoc(collection(db, "recovery_logs"), {
        actionType: "RESTORE_PURCHASES",
        userEmail: email,
        restoredBy: performedByEmail,
        restoredDate: new Date().toISOString(),
        restoredPackages: restoredPkgIds,
        notes: `Admin restored ${restoredPkgIds.length} course(s) license for student account.`,
        performedBy: performedByEmail,
        actionDate: Date.now()
      });

      showToast("Restored " + restoredPkgIds.length + " course(s) for " + email + "! 🎓");
