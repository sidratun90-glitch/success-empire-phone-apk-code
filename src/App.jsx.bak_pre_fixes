const AdminCertificatesView = ({ db, adminUsersList, PACKAGES, appSettings, goBack }) => {
  const [certTab, setCertTab] = useState("issued"); // "issued" | "issue_manual" | "customizer" | "pending_requests"

  // Tab: Issued Certificates
  const [issuedCerts, setIssuedCerts] = useState([]);
  const [loadingCerts, setLoadingCerts] = useState(true);
  const [certSearchQuery, setCertSearchQuery] = useState("");

  // Tab: Manual Issuance
  const [selectedStudentUid, setSelectedStudentUid] = useState("");
  const [selectedCourseId, setSelectedCourseId] = useState("");
  const [customIssueDate, setCustomIssueDate] = useState("");
  const [issuingProgress, setIssuingProgress] = useState(false);
  const [issuedSuccessMessage, setIssuedSuccessMessage] = useState("");

  // Tab: Pending Requests
  const [pendingApps, setPendingApps] = useState([]);
  const [loadingPending, setLoadingPending] = useState(true);

  // Tab: Customizer
  const [certTitle, setCertTitle] = useState(appSettings?.certTitle || "CERTIFICATE OF COMPLETION");
  const [certSubHeader, setCertSubHeader] = useState(appSettings?.certSubHeader || "for successfully completing the official certification course:");
  const [certSignatoryName, setCertSignatoryName] = useState(appSettings?.certSignatoryName || "Success Empire");
  const [certSignatoryTitle, setCertSignatoryTitle] = useState(appSettings?.certSignatoryTitle || "Authorized Signatory");
  const [certSignatureUrl, setCertSignatureUrl] = useState(appSettings?.certSignatureUrl || "");
  const [certBackgroundUrl, setCertBackgroundUrl] = useState(appSettings?.certBackgroundUrl || "");
  const [saveProgress, setSaveProgress] = useState(false);
  const [uploadProgress, setUploadProgress] = useState(0);
  const [isUploading, setIsUploading] = useState(false);

  // Load issued certificates from database
  useEffect(() => {
    if (!db) return;
    const certsCol = collection(db, "certificates");
    const unsub = onSnapshot(certsCol, (snapshot) => {
      const list = [];
      snapshot.forEach(docSnap => {
        list.push(docSnap.data());
      });
      // Sort by issuedAt descending
      list.sort((a, b) => (b.issuedAt || 0) - (a.issuedAt || 0));
      setIssuedCerts(list);
      setLoadingCerts(false);
    }, (err) => {
      console.error("Failed to load certificates:", err);
      setLoadingCerts(false);
    });
    return unsub;
  }, [db]);

  // Load pending certificate applications from database
  useEffect(() => {
    if (!db) return;
    const appsCol = collection(db, "certificate_applications");
    const q = query(appsCol, where("status", "==", "pending"));
    const unsub = onSnapshot(q, (snapshot) => {
      const list = [];
      snapshot.forEach(docSnap => {
        list.push(docSnap.data());
      });
      list.sort((a, b) => (b.appliedAt || 0) - (a.appliedAt || 0));
      setPendingApps(list);
      setLoadingPending(false);
    }, (err) => {
      console.error("Failed to load pending applications:", err);
      setLoadingPending(false);
    });
    return unsub;
  }, [db]);

  // Sync customizer settings if appSettings updates
  useEffect(() => {
    if (appSettings) {
      if (appSettings.certTitle) setCertTitle(appSettings.certTitle);
      if (appSettings.certSubHeader) setCertSubHeader(appSettings.certSubHeader);
      if (appSettings.certSignatoryName) setCertSignatoryName(appSettings.certSignatoryName);
      if (appSettings.certSignatoryTitle) setCertSignatoryTitle(appSettings.certSignatoryTitle);
      if (appSettings.certSignatureUrl) setCertSignatureUrl(appSettings.certSignatureUrl);
      if (appSettings.certBackgroundUrl) setCertBackgroundUrl(appSettings.certBackgroundUrl);
    }
  }, [appSettings]);

  // Handle manual certificate issuance
  const handleIssueCertificate = async (e) => {
    e.preventDefault();
    if (!selectedStudentUid) {
      alert("Please select a student!");
      return;
    }
    if (!selectedCourseId) {
      alert("Please select a package/course!");
      return;
    }

    setIssuingProgress(true);
    setIssuedSuccessMessage("");

    try {
      const student = adminUsersList.find(u => u.uid === selectedStudentUid);
      const pkg = PACKAGES.find(p => String(p.id) === String(selectedCourseId));

      if (!student) throw new Error("Student not found!");
      if (!pkg) throw new Error("Package not found!");

      const helperHash = (str) => {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
          hash = (hash << 5) - hash + str.charCodeAt(i);
          hash |= 0;
        }
        return hash;
      };

      const studentName = student.name || student.email || "Student";
      const certId = `SE-${Math.abs(helperHash(studentName + pkg.title)).toString(36).toUpperCase()}`;

      const issueTime = customIssueDate ? new Date(customIssueDate).getTime() : Date.now();

      const certDocRef = doc(db, "certificates", certId);
      await setDoc(certDocRef, {
        id: certId,
        userId: student.uid,
        userName: studentName,
        userEmail: student.email,
        courseId: pkg.id,
        courseTitle: pkg.title,
        issuedAt: issueTime,
        issuedBy: "admin"
      }, { merge: true });

      setIssuedSuccessMessage(`Certificate successfully issued! ID: ${certId}`);
      setSelectedStudentUid("");
      setSelectedCourseId("");
      setCustomIssueDate("");
    } catch (err) {
      console.error("Failed to issue certificate:", err);
      alert("Failed to issue certificate: " + err.message);
    } finally {
      setIssuingProgress(false);
    }
  };

  // Revoke/Delete certificate
  const handleRevokeCertificate = async (certId) => {
    const reason = window.prompt(`Enter revocation reason for certificate ${certId} (optional):`, "Expired or academic integrity issue");
    if (reason === null) return; // User cancelled

    try {
      await updateDoc(doc(db, "certificates", certId), {
        status: "revoked",
        revokedAt: Date.now(),
        revocationReason: reason.trim() || "Revoked by Administrator"
      });
    } catch (err) {
      console.error("Failed to revoke certificate:", err);
      alert("Error revoking certificate: " + err.message);
    }
  };

  const handleReinstateCertificate = async (certId) => {
    if (!window.confirm(`Are you sure you want to reinstate certificate ${certId}?`)) {
      return;
    }
    try {
      await updateDoc(doc(db, "certificates", certId), {
        status: "verified",
        revokedAt: null,
        revocationReason: null
      });
    } catch (err) {
      console.error("Failed to reinstate certificate:", err);
      alert("Error reinstating certificate: " + err.message);
    }
  };

  const handleApproveApplication = async (app) => {
    if (!db) return;
    try {
      const helperHash = (str) => {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
          hash = (hash << 5) - hash + str.charCodeAt(i);
          hash |= 0;
        }
        return hash;
      };

      const certId = `SE-${Math.abs(helperHash(app.userName + app.courseTitle)).toString(36).toUpperCase()}`;

      const certDocRef = doc(db, "certificates", certId);
      await setDoc(certDocRef, {
        id: certId,
        userId: app.userId,
        userName: app.userName,
        userEmail: app.userEmail,
        courseId: app.courseId,
        courseTitle: app.courseTitle,
        issuedAt: Date.now(),
        issuedBy: "admin",
        status: "verified"
      }, { merge: true });

      const appRef = doc(db, "certificate_applications", app.id);
      await updateDoc(appRef, {
        status: "approved",
        certificateId: certId,
        approvedAt: Date.now()
      });

      alert(`Application approved and certificate issued! ID: ${certId}`);
    } catch (err) {
      console.error("Failed to approve application:", err);
      alert("Error: " + err.message);
    }
  };

  const handleRejectApplication = async (app) => {
    const reason = window.prompt("Enter rejection reason (optional):");
    if (reason === null) return;
    if (!db) return;
    try {
      const appRef = doc(db, "certificate_applications", app.id);
      await updateDoc(appRef, {
        status: "rejected",
        rejectionReason: reason.trim() || "Rejected by Administrator",
        rejectedAt: Date.now()
      });
      alert("Application rejected.");
    } catch (err) {
      console.error("Failed to reject application:", err);
      alert("Error: " + err.message);
    }
  };

  // Save customizer settings
  const handleSaveSettings = async () => {
    setSaveProgress(true);
    try {
      const appDocRef = doc(db, "settings", "app");
      await updateDoc(appDocRef, {
        certTitle,
        certSubHeader,
        certSignatoryName,
        certSignatoryTitle,
        certSignatureUrl,
        certBackgroundUrl
      });
      alert("Certificate settings saved successfully!");
    } catch (err) {
      console.error("Failed to save certificate settings:", err);
      alert("Error: " + err.message);
    } finally {
      setSaveProgress(false);
    }
  };

  // Upload Signature Image to Cloudinary
  const handleSignatureUpload = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    setIsUploading(true);
    setUploadProgress(10);
    try {
      const url = await uploadFileToCloudinary(file, "certificates", (progress) => {
        setUploadProgress(progress);
      });
      setCertSignatureUrl(url);
      setUploadProgress(100);
      setTimeout(() => setIsUploading(false), 500);
    } catch (err) {
      console.error("Upload failed:", err);
      alert(err.message);
      setIsUploading(false);
    }
  };

  // Filter issued certificates
  const filteredCerts = issuedCerts.filter(c => {
    const queryStr = certSearchQuery.toLowerCase();
    return (
      (c.id && c.id.toLowerCase().includes(queryStr)) ||
      (c.userName && c.userName.toLowerCase().includes(queryStr)) ||
      (c.userEmail && c.userEmail.toLowerCase().includes(queryStr)) ||
      (c.courseTitle && c.courseTitle.toLowerCase().includes(queryStr))
    );
  });

  return (
    <div className="animate-fade-in pb-10 flex flex-col h-full admin-view">
      {/* Header */}
      <div className="flex items-center gap-3 mb-6 pt-4">
        <button onClick={goBack} className="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center text-white hover:bg-white/20 transition-all">
          <ChevronLeft size={18} />
        </button>
        <div>
          <span className="text-purple-400 text-[10px] font-bold tracking-widest uppercase mb-0.5 block">Management Tools</span>
          <h1 className="text-xl font-bold text-white">Certificates</h1>
        </div>
      </div>

      {/* Tabs */}
      <div className="flex bg-black/40 p-1 rounded-xl border border-white/10 mb-6 shrink-0">
        <button
          onClick={() => setCertTab("issued")}
          className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${certTab === 'issued' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}
        >
          Issued Log ({issuedCerts.length})
        </button>
        <button
          onClick={() => setCertTab("issue_manual")}
          className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${certTab === 'issue_manual' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}
        >
          Issue Manually
        </button>
        <button
          onClick={() => setCertTab("customizer")}
          className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${certTab === 'customizer' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}
        >
          Branding Customizer
        </button>
        <button
          onClick={() => setCertTab("pending_requests")}
          className={`flex-1 py-2 text-xs font-bold rounded-lg transition-all ${certTab === 'pending_requests' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-400 hover:text-white'}`}
        >
          Pending Requests ({pendingApps.length})
        </button>
      </div>

      {/* Tab Contents */}
      <div className="flex-1 flex flex-col min-h-0">
        {certTab === 'issued' && (
          <div className="flex-1 flex flex-col min-h-0 bg-white/5 border border-white/10 rounded-2xl p-4">
            {/* Search */}
            <div className="relative mb-4 shrink-0">
              <input
                type="text"
                value={certSearchQuery}
                onChange={e => setCertSearchQuery(e.target.value)}
                placeholder="Search by ID, name, email, or course..."
