          originalPurchaseDate: newOriginalPurchaseDate,
          lastUpgradeDate: newLastUpgradeDate,
          upgradeEligibleUntil: newUpgradeEligibleUntil,
          packageHistory: updatedHistory
        };

        await setDoc(userDocRef, updatedProfile, { merge: true });

        // Helper hash function for generating unique certificateIds
        const helperHash = (str) => {
          let hash = 0;
          for (let i = 0; i < str.length; i++) {
            hash = (hash << 5) - hash + str.charCodeAt(i);
            hash |= 0;
          }
          return hash;
        };

        const certId = `SE-${Math.abs(helperHash((userName || auth.currentUser.email || 'Student') + (targetPkg ? targetPkg.title : `Package #${packageId}`))).toString(36).toUpperCase()}`;

        const paymentIdVal = txnData ? txnData.id : `SE-PAY-${now.toString().slice(-6)}`;

        // Write immutable purchase record
        const purchaseRecordData = {
          uid: auth.currentUser.uid,
          userName: userName || auth.currentUser.displayName || 'Student',
          email: userEmail || auth.currentUser.email || 'unknown@example.com',
          packageName: targetPkg ? targetPkg.title : `Package #${packageId}`,
          packageId: packageId,
          courseId: packageId,
          amountPaid: amountPaidVal,
          paymentId: paymentIdVal,
          transactionId: paymentIdVal,
          purchaseDate: now,
          approvedAt: now,
          paymentStatus: 'approved',
          adminName: 'self',
          restoreStatus: 'original',
          certificateId: certId
        };
        await addDoc(collection(db, "purchase_records"), purchaseRecordData);

        setCurrentPackage(newCurrentPackage);
        setPurchaseAmount(newPurchaseAmount);
        setPurchaseDate(now);
        setOriginalPurchaseDate(newOriginalPurchaseDate);
        setLastUpgradeDate(newLastUpgradeDate);
        setUpgradeEligibleUntil(newUpgradeEligibleUntil);
        setPackageHistory(updatedHistory);

        if (txnData) {
          await setDoc(doc(db, "payments", txnData.id), txnData);
        }

        if (appliedCouponCode) {
          const couponDocRef = doc(db, "coupons", appliedCouponCode.toUpperCase());
          try {
            await runTransaction(db, async (transaction) => {
              const couponSnap = await transaction.get(couponDocRef);
              if (!couponSnap.exists()) {
                throw new Error("Coupon does not exist!");
              }
              const couponData = couponSnap.data();

              // Double checks for safety inside transaction
              if (couponData.expiryTime && couponData.expiryTime <= Date.now()) {
                throw new Error("Coupon has expired!");
              }
              if (couponData.usageLimit && (couponData.usedCount || 0) >= couponData.usageLimit) {
                throw new Error("Coupon usage limit reached!");
              }
              if (couponData.usedBy && couponData.usedBy.includes(auth.currentUser.uid)) {
                throw new Error("You have already used this coupon!");
              }

              const discountAmt = txnData ? (txnData.discountAmount || 0) : 0;
              const newUsedBy = [...(couponData.usedBy || []), auth.currentUser.uid];

              transaction.update(couponDocRef, {
                usedCount: (couponData.usedCount || 0) + 1,
                totalDiscountGiven: (couponData.totalDiscountGiven || 0) + discountAmt,
                usedBy: newUsedBy
              });
            });
            console.log("[COUPON] Firestore transaction successfully completed.");
          } catch (couponTxErr) {
            console.error("[COUPON] Firestore transaction failed:", couponTxErr);
          }
        }
      } catch (err) {
        console.error("Failed to sync purchase or payment to Firestore:", err);
