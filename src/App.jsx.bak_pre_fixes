  const handleGlobalTouchStart = (e) => {
    const currentScreen = route?.screen;
    if (
      isRefreshing ||
      currentScreen === 'player' ||
      currentScreen === 'splash' ||
      currentScreen === 'onboarding' ||
      croppingData ||
      e.target?.closest?.('#mini-player-container')
    ) {
      return;
    }

    const touch = e.touches[0];
    pullTouchStartRef.current = { y: touch.clientY, x: touch.clientX };

    // Find the closest scrollable container for the touch target
    let el = touch.target;
    let foundScrollContainer = null;
    while (el && el !== e.currentTarget) {
      const style = window.getComputedStyle(el);
      const overflowY = style.overflowY;
      const isScrollable = (overflowY === 'auto' || overflowY === 'scroll') && el.scrollHeight > el.clientHeight;
      if (isScrollable) {
        foundScrollContainer = el;
        break;
      }
      el = el.parentElement;
    }

    activeScrollContainerRef.current = foundScrollContainer;

    // We only initiate pull if there is no scrollable container, OR if the scrollable container is at the very top (scrollTop === 0)
    if (!foundScrollContainer || foundScrollContainer.scrollTop === 0) {
      isPullActiveRef.current = true;
    } else {
      isPullActiveRef.current = false;
    }
  };

  const handleGlobalTouchMove = (e) => {
    if (!isPullActiveRef.current || isRefreshing) return;

    const touch = e.touches[0];
    const deltaY = touch.clientY - pullTouchStartRef.current.y;
    const deltaX = touch.clientX - pullTouchStartRef.current.x;

    // If the drag is mostly horizontal, ignore it to prevent conflict with swipe gestures
    if (Math.abs(deltaX) > Math.abs(deltaY)) {
      isPullActiveRef.current = false;
      return;
    }

    // If dragging down
    if (deltaY > 0) {
      // Check again if the scroll container has scrolled down in the meantime
      if (activeScrollContainerRef.current && activeScrollContainerRef.current.scrollTop > 0) {
        isPullActiveRef.current = false;
        return;
      }

      // Prevent native browser scroll bounce
      if (e.cancelable) {
        e.preventDefault();
      }

      // Apply resistance: drag gets harder as you pull down further
      const resistance = 0.5;
      const dist = Math.min(120, deltaY * resistance);
      setPullDistance(dist);
    } else {
      // If dragging up, reset
      setPullDistance(0);
    }
  };

