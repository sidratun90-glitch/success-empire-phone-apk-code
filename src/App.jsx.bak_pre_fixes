      videoElRef.current.volume = volume;
    }
  }, [volume, isPlaying]);

  // --- Picture-in-Picture Floating Player States and Gestures ---
  const [isMiniPlayerEnlarged, setIsMiniPlayerEnlarged] = useState(false);
  const [showMiniControls, setShowMiniControls] = useState(false);
  const miniControlsTimeoutRef = useRef(null);
  const lastPipTapRef = useRef(0);

  const [pipPosition, setPipPosition] = useState(() => {
    const width = window.innerWidth;
    const height = window.innerHeight;
    return { x: width - 236, y: height - 230 };
  });
  const [isDraggingPip, setIsDraggingPip] = useState(false);
  const [isOverDeleteZone, setIsOverDeleteZone] = useState(false);
  const [showDeleteZone, setShowDeleteZone] = useState(false);
  const dragStartRef = useRef({ x: 0, y: 0 });
  const dragStartPosRef = useRef({ x: 0, y: 0 });

  useEffect(() => {
    return () => {
      if (miniControlsTimeoutRef.current) clearTimeout(miniControlsTimeoutRef.current);
    };
  }, []);

  const handlePipDragStart = (e) => {
    if (viewMode !== 'minimized') return;
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    dragStartRef.current = { x: clientX, y: clientY };
    dragStartPosRef.current = { ...pipPosition };
    setIsDraggingPip(true);
    if (e.cancelable) e.preventDefault();
  };

  const handlePipDragMove = (e) => {
    if (!isDraggingPip || viewMode !== 'minimized') return;
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    const deltaX = clientX - dragStartRef.current.x;
    const deltaY = clientY - dragStartRef.current.y;
    const newX = dragStartPosRef.current.x + deltaX;
    const newY = dragStartPosRef.current.y + deltaY;

    const pipWidth = isMiniPlayerEnlarged ? 340 : 220;
    const pipHeight = isMiniPlayerEnlarged ? 191 : 124;
    const targetCenterX = (() => {
      const container = document.querySelector('.phone-container');
      if (container) {
        const rect = container.getBoundingClientRect();
        return rect.left + rect.width / 2;
      }
      return window.innerWidth / 2;
    })();

    const targetCenterY = (() => {
      const container = document.querySelector('.phone-container');
      if (container) {
        const rect = container.getBoundingClientRect();
        return rect.bottom - 104; // 104px aligns with bottom-20 and w-12 height center (80px bottom + 24px half height)
      }
      return window.innerHeight - 104;
