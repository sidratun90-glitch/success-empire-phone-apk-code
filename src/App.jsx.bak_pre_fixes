          report.errors.push(`Lesson at index ${lIdx} in package '${pkg.title}' is missing essential fields.`);
        }
        if (!l.thumbnail) {
          missingThumbs++;
        }

        const hasDirectVideo = !!l.videoUrl;
        const hasQualitiesVideo = l.videoUrls && Object.values(l.videoUrls).some(url => !!url);
        if (hasDirectVideo || hasQualitiesVideo) {
          videosCount++;
        } else {
          missingVideos++;
        }
      });
    });

    report.totalLessons = lessonsCount;
    report.totalVideos = videosCount;
    report.missingVideoUrls = missingVideos;
    report.missingThumbnails = missingThumbs;
    report.invalidRecords = invalidCount;

    let score = 100;
    score -= (invalidCount * 15);
    if (lessonsCount > 0) {
      score -= ((missingVideos / lessonsCount) * 50);
    }
    const totalThumbs = packages.length + lessonsCount;
    if (totalThumbs > 0) {
      score -= ((missingThumbs / totalThumbs) * 30);
    }
    if (!report.isValid) {
      score -= 20;
    }

    report.integrityScore = Math.max(0, Math.min(100, Math.round(score)));
    return report;
  };

