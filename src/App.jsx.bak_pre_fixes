const AdminQuizEditorView = ({ db, PACKAGES, goBack }) => {
  const [selectedPkgId, setSelectedPkgId] = useState("2000000000004");
  const [questions, setQuestions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    if (!db || !selectedPkgId) return;
    setLoading(true);
    const docRef = doc(db, "quizzes", selectedPkgId);
    getDoc(docRef).then((docSnap) => {
      if (docSnap.exists()) {
        setQuestions(docSnap.data().questions || []);
      } else {
        setQuestions(getQuizQuestions(selectedPkgId) || []);
      }
      setLoading(false);
    }).catch(err => {
      console.error("Error loading quiz:", err);
      setQuestions(getQuizQuestions(selectedPkgId) || []);
      setLoading(false);
    });
  }, [db, selectedPkgId]);

  const handleAddQuestion = () => {
    setQuestions(prev => [
      ...prev,
      {
        questionText: "New Question Text?",
        options: ["Option 1", "Option 2", "Option 3", "Option 4"],
        correctAnswerIndex: 0
      }
    ]);
  };

  const handleUpdateQuestionText = (index, value) => {
    setQuestions(prev => {
      const copy = [...prev];
      copy[index] = { ...copy[index], questionText: value };
      return copy;
    });
  };

  const handleUpdateOptionText = (qIndex, oIndex, value) => {
    setQuestions(prev => {
      const copy = [...prev];
      const optsCopy = [...copy[qIndex].options];
      optsCopy[oIndex] = value;
      copy[qIndex] = { ...copy[qIndex], options: optsCopy };
      return copy;
    });
  };

  const handleUpdateCorrectIndex = (qIndex, oIndex) => {
    setQuestions(prev => {
      const copy = [...prev];
      copy[qIndex] = { ...copy[qIndex], correctAnswerIndex: oIndex };
      return copy;
    });
  };

  const handleDeleteQuestion = (index) => {
    setQuestions(prev => prev.filter((_, i) => i !== index));
  };

  const handleResetToDefault = () => {
    if (window.confirm("Are you sure you want to reset this quiz to default questions?")) {
      setQuestions(getQuizQuestions(selectedPkgId) || []);
    }
  };

  const handleSaveQuiz = async () => {
    if (!db) return;
    for (let i = 0; i < questions.length; i++) {
      if (!questions[i].questionText.trim()) {
        alert(`Question ${i + 1} text cannot be empty!`);
        return;
      }
      for (let j = 0; j < 4; j++) {
        if (!questions[i].options[j] || !questions[i].options[j].trim()) {
          alert(`Option ${j + 1} for Question ${i + 1} cannot be empty!`);
          return;
        }
      }
    }

    setSaving(true);
    try {
      const docRef = doc(db, "quizzes", selectedPkgId);
      await setDoc(docRef, { questions }, { merge: true });
      alert("Quiz saved successfully!");
    } catch (err) {
      console.error("Failed to save quiz:", err);
      alert("Error saving quiz: " + err.message);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="animate-fade-in pb-10 flex flex-col h-full text-left admin-view">
      <div className="flex items-center gap-3 mb-6 pt-4 shrink-0">
        <button onClick={goBack} className="w-8 h-8 bg-white/10 rounded-full flex items-center justify-center text-white hover:bg-white/20 transition-all">
          <ChevronLeft size={18} />
        </button>
        <div>
          <span className="text-purple-400 text-[10px] font-bold tracking-widest uppercase mb-0.5 block">Course Management</span>
          <h1 className="text-xl font-bold text-white">MCQ Quiz Editor</h1>
        </div>
      </div>

      {/* Select Course Package Card Grid */}
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 shrink-0">
        {PACKAGES.map((p) => {
          const isSelected = String(p.id) === String(selectedPkgId);
          return (
            <button
              key={p.id}
              onClick={() => setSelectedPkgId(String(p.id))}
              className={`p-3 rounded-xl border text-left transition-all ${isSelected
                ? 'bg-indigo-600/25 border-indigo-500 shadow-[0_4px_20px_rgba(99,102,241,0.2)]'
                : 'bg-white/5 border-white/10 hover:bg-white/10'
                }`}
            >
              <h3 className={`text-xs font-bold ${isSelected ? 'text-white' : 'text-gray-300'}`}>{p.title}</h3>
              <p className="text-[9px] text-gray-500 mt-1 uppercase tracking-wider font-extrabold">Package {p.id}</p>
            </button>
          );
        })}
      </div>

      <div className="flex-1 flex flex-col min-h-0 bg-white/5 border border-white/10 rounded-2xl p-5">
        <div className="flex justify-between items-center mb-4 shrink-0">
          <h2 className="text-xs font-extrabold text-white uppercase tracking-wider">Quiz Questions List</h2>
          <button
            onClick={handleAddQuestion}
            className="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 active:scale-95 text-white font-bold text-[10px] uppercase tracking-wider rounded-lg flex items-center gap-1.5 transition-all shadow-md"
          >
            <Plus size={12} /> Add Question
          </button>
        </div>

        {loading ? (
          <div className="flex-1 flex items-center justify-center">
            <div className="w-8 h-8 border-4 border-indigo-500/20 border-t-indigo-600 rounded-full animate-spin"></div>
          </div>
        ) : questions.length === 0 ? (
          <div className="flex-1 flex flex-col items-center justify-center text-center p-6">
            <AlertTriangle size={32} className="text-gray-500 mb-2" />
            <p className="text-xs text-gray-400">No questions configured for this course quiz.</p>
          </div>
        ) : (
          <div className="flex-1 overflow-y-auto space-y-6 pr-1 hide-scrollbar min-h-0">
            {questions.map((q, qIndex) => (
              <div key={qIndex} className="bg-black/30 border border-white/10 rounded-xl p-4 relative hover:border-white/20 transition-colors">
                <button
                  onClick={() => handleDeleteQuestion(qIndex)}
                  className="absolute top-4 right-4 w-7 h-7 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg flex items-center justify-center transition-all"
                  title="Delete Question"
                >
                  <Trash2 size={13} />
                </button>

                <span className="text-[10px] text-indigo-400 font-extrabold uppercase tracking-widest block mb-2">Question {qIndex + 1}</span>

                <div className="space-y-4">
                  <div>
                    <label className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">Question Prompt</label>
                    <input
                      type="text"
                      value={q.questionText}
                      onChange={(e) => handleUpdateQuestionText(qIndex, e.target.value)}
                      placeholder="e.g. What does CPU stand for?"
                      className="w-full bg-black/50 border border-white/10 rounded-lg px-3 py-2 text-xs text-white outline-none focus:border-indigo-500"
                    />
                  </div>

                  <div className="space-y-2">
                    <label className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">Answer Options & Correct Option Selection</label>
                    {q.options.map((opt, oIndex) => {
                      const isCorrect = q.correctAnswerIndex === oIndex;
                      return (
                        <div key={oIndex} className="flex gap-2 items-center">
                          <button
                            onClick={() => handleUpdateCorrectIndex(qIndex, oIndex)}
                            className={`px-3 py-2 text-[10px] font-black uppercase tracking-wider rounded-lg border transition-all ${isCorrect
                              ? 'bg-green-600/20 border-green-500 text-green-400'
                              : 'bg-black/30 border-white/10 text-gray-500 hover:border-white/20'
                              }`}
                          >
                            {isCorrect ? 'Correct' : 'Mark'}
                          </button>
                          <input
                            type="text"
                            value={opt}
                            onChange={(e) => handleUpdateOptionText(qIndex, oIndex, e.target.value)}
                            placeholder={`Option ${oIndex + 1}`}
                            className={`flex-1 bg-black/50 border rounded-lg px-3 py-2 text-xs text-white outline-none focus:border-indigo-500 ${isCorrect ? 'border-green-500/35' : 'border-white/10'
                              }`}
                          />
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        <div className="flex gap-3 mt-6 border-t border-white/5 pt-4 shrink-0">
          <button
            onClick={handleResetToDefault}
            className="flex-1 py-3 bg-white/5 hover:bg-white/10 text-gray-300 border border-white/10 font-bold text-xs uppercase tracking-wider rounded-xl flex items-center justify-center gap-1.5 active:scale-95 transition-all"
          >
            <RotateCcw size={13} /> Reset Default
          </button>
          <button
            onClick={handleSaveQuiz}
            disabled={saving}
            className="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 disabled:bg-gray-700 text-white font-bold text-xs uppercase tracking-wider rounded-xl flex items-center justify-center gap-1.5 active:scale-95 transition-all shadow-lg"
          >
            {saving ? (
              <div className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            ) : (
              <>
                <CheckCircle size={13} /> Save Quiz
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
};

