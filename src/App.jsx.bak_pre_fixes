          <div className="fixed inset-0 z-[500] flex items-center justify-center bg-black/85 backdrop-blur-md px-4">
            <div className="bg-slate-900 border border-purple-500/20 rounded-[2.5rem] p-8 w-full max-w-sm shadow-[0_20px_50px_rgba(139,92,246,0.15)] flex flex-col space-y-6 text-center animate-pop-in">
              <div className="w-16 h-16 bg-red-500/10 rounded-full flex items-center justify-center mx-auto border border-red-500/20 text-red-400">
                <AlertTriangle size={32} className="animate-bounce" />
              </div>

              <div className="space-y-2">
                <h3 className="text-white font-black text-lg tracking-wide">Cancel Payment?</h3>
                <p className="text-gray-300 text-xs leading-relaxed">
                  Are you sure you want to cancel payment? Processing payment cancel karne se package unlock nahi hoga.
                </p>
              </div>

              <div className="flex gap-4">
                <button
                  onClick={() => setCancelPaymentConfirm(false)}
                  className="flex-1 py-4 rounded-xl bg-white/5 border border-white/10 text-white font-black text-xs active:scale-95 transition-all"
                >
                  No, Continue
                </button>
                <button
                  onClick={() => {
                    setCancelPaymentConfirm(false);
                    window.paymentProcessingActive = false;
                    handleNav({ screen: 'package', pkg: route.pkg });
                  }}
                  className="flex-1 py-4 rounded-xl bg-gradient-to-r from-red-600 to-rose-600 text-white font-black text-xs active:scale-95 transition-all shadow-lg shadow-red-900/30"
                >
                  Yes, Cancel
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Default Posters Modal */}
        {showDefaultPostersModal && (
          <div className="fixed inset-0 z-[600] flex items-center justify-center bg-black/75 backdrop-blur-md px-4 animate-fade-in" onClick={() => setShowDefaultPostersModal(false)}>
            <div className="bg-white border border-gray-150 rounded-[2.5rem] p-6 w-full max-w-md shadow-[0_20px_50px_rgba(0,0,0,0.3)] flex flex-col max-h-[80vh] animate-pop-in" onClick={(e) => e.stopPropagation()}>
              {/* Header */}
              <div className="flex items-center justify-between pb-3.5 border-b border-gray-100 mb-4 shrink-0">
                <div>
                  <h3 className="text-gray-900 text-lg font-black tracking-wide font-sans">
                    All Standard Banners 📚
                  </h3>
                  <p className="text-gray-400 text-[9px] font-extrabold uppercase tracking-wider mt-0.5">
                    Click a poster to explore course
                  </p>
                </div>
                <button
                  onClick={() => setShowDefaultPostersModal(false)}
                  className="w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center text-gray-500 transition-colors cursor-pointer active:scale-95"
                >
                  <X size={16} />
                </button>
              </div>

              {/* Scrollable list of posters */}
              <div className="flex-1 overflow-y-auto pr-1 py-1 hide-scrollbar">
                <div className="grid grid-cols-2 gap-4">
                  {[
                    { id: 'default_meta_ads', title: 'Meta Ads Mastery', image: metaAdsImg },
                    { id: 'default_ai_app_gen', title: 'AI App Generator', image: aiAppGenImg },
                    { id: 'default_auto_mastery', title: 'Automation Mastery', image: autoMasteryImg },
                    { id: 'default_ai_video_gen', title: 'AI Video Generator', image: aiVideoGenImg },
                    { id: 'default_youtube_dom', title: 'YouTube Domination', image: youtubeDomImg },
                    { id: 'default_ai_prompt_eng', title: 'AI Prompt Engineering', image: promptEngImg }
                  ].map((poster) => {
                    const searchKeywordsMap = {
                      'default_meta_ads': 'meta ads',
                      'default_ai_app_gen': 'ai app',
                      'default_auto_mastery': 'automation',
                      'default_youtube_dom': 'youtube'
                    };
                    const searchKeyword = searchKeywordsMap[poster.id];
                    let isLocked = true;
                    let isComingSoon = false;
                    if (searchKeyword) {
                      const pkg = (PACKAGES || []).find(p => p && p.title && p.title.toLowerCase().includes(searchKeyword));
                      if (pkg) {
                        isLocked = !(effectivePurchasedPackages || []).includes(pkg.id);
                        if (pkg.lessons && pkg.lessons[0] && pkg.lessons[0].isComingSoon) {
                          isComingSoon = true;
                        }
                      }
                    }

                    return (
                      <div
                        key={poster.id}
                        onClick={() => handleDefaultPosterClick(poster.id)}
                        className="group flex flex-col gap-2 cursor-pointer active:scale-95 transition-transform"
                      >
                        <div className="relative aspect-video rounded-xl overflow-hidden border border-gray-150 shadow-sm bg-gray-50">
                          <img
                            src={poster.image}
                            alt={poster.title}
                            className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          />
                          <div className="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none" />

                          {/* Status badge */}
                          <div className="absolute top-1.5 right-1.5 bg-black/60 backdrop-blur-md px-1.5 py-0.5 rounded text-[8px] font-extrabold text-white flex items-center gap-1 shadow-md">
                            {isComingSoon ? (
                              <span className="text-amber-400">Soon</span>
                            ) : isLocked ? (
                              <Lock size={8} className="text-white" />
                            ) : (
                              <PlayCircle size={8} className="text-green-400" />
                            )}
                          </div>
                        </div>
                        <span className="text-[10px] font-black text-gray-800 text-center line-clamp-1 group-hover:text-purple-600 transition-colors">
                          {poster.title}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}