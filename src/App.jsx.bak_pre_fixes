    videoUrl: ""
  };

  const isPurchased = purchasedPackages && purchasedPackages.includes(packageId);
  const currentPlaylist = lessonsList.filter(l => l.courseName === lesson.courseName);
  const currentPlaylistIndex = currentPlaylist.findIndex(l => String(l.id) === String(lessonId));
  const isLessonLocked = lesson.isLocked && !isPurchased;

  useEffect(() => {
    const handleKeyDown = (e) => {
      const activeEl = document.activeElement;
      if (activeEl && (
        activeEl.tagName === 'INPUT' ||
        activeEl.tagName === 'TEXTAREA' ||
        activeEl.isContentEditable
      )) {
        return;
      }

      if (e.key === 'N' || e.key === 'n') {
        const nextIdx = currentPlaylistIndex + 1;
        if (nextIdx < currentPlaylist.length) {
          const nextL = currentPlaylist[nextIdx];
          const isPurchasedPkg = purchasedPackages && pkg && purchasedPackages.some(pId => String(pId) === String(pkg.id));
          const locked = nextL.isLocked && !isPurchasedPkg;
          const comingSoon = nextL.isComingSoon;
          if (comingSoon) {
            showToast(`${nextL.title} जल्द आ रहा है!`);
          } else if (locked) {
            showToast("पहले कोर्स परचेस करना पड़ेगा");
          } else {
            navigateTo('player', pkg ? pkg.id : packageId, nextL.id, true);
          }
        }
      } else if (e.key === 'P' || e.key === 'p') {
        const prevIdx = currentPlaylistIndex - 1;
        if (prevIdx >= 0) {
          const prevL = currentPlaylist[prevIdx];
          const isPurchasedPkg = purchasedPackages && pkg && purchasedPackages.some(pId => String(pId) === String(pkg.id));
          const locked = prevL.isLocked && !isPurchasedPkg;
          const comingSoon = prevL.isComingSoon;
          if (comingSoon) {
            showToast(`${prevL.title} जल्द आ रहा है!`);
          } else if (locked) {
            showToast("पहले कोर्स परचेस करना पड़ेगा");
          } else {
            navigateTo('player', pkg ? pkg.id : packageId, prevL.id, true);
          }
        }
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => {
      window.removeEventListener('keydown', handleKeyDown);
    };
  }, [currentPlaylist, currentPlaylistIndex, pkg, packageId, purchasedPackages, navigateTo]);

  // --- Certification and Quiz States ---
  const [certApplication, setCertApplication] = useState(null);
  const [loadingCertApp, setLoadingCertApp] = useState(false);
