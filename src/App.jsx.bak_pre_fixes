      recordsSnap.forEach(docSnap => {
        const data = docSnap.data();
        if ((email && data.email?.toLowerCase() === email.toLowerCase()) || (uid && data.uid === uid)) {
          userRecords.push({ id: docSnap.id, ...data });
        }
      });

      if (!liveUser && userRecords.length === 0) {
        showToast("No active user or purchase records found matching query.");
        setSingleUserQuerying(false);
        return;
      }

      setSingleUserResult({
        uid: uid || qStr,
        email: email || qStr,
        exists: !!liveUser,
        purchasedPackages: liveUser ? (liveUser.purchasedPackages || []) : [],
        records: userRecords
      });

      // Run user specific dry-run
      if (liveUser) {
        let toRestore = [];
        let alreadyUnlocked = [];
        userRecords.forEach(rec => {
          const pkgId = rec.packageId || rec.courseId;
          if (liveUser.purchasedPackages?.includes(pkgId)) {
            alreadyUnlocked.push(rec);
          } else {
            toRestore.push(rec);
          }
        });
        setSingleUserDryRun({
          alreadyUnlocked,
          toRestore
        });
