const NotificationScreen = ({ goBack, notifications = [], setNotifications }) => {
  const markAllRead = () => {
    if (setNotifications) {
      try {
        const savedIds = JSON.parse(localStorage.getItem('success_empire_read_notif_ids') || '[]');
        notifications.forEach(n => {
          if (n && n.id) {
            const strId = n.id.toString();
            if (!savedIds.includes(n.id)) savedIds.push(n.id);
            if (!savedIds.includes(strId)) savedIds.push(strId);
          }
        });
        localStorage.setItem('success_empire_read_notif_ids', JSON.stringify(savedIds));
      } catch (e) {
        console.error(e);
      }
      setNotifications(prev => prev.map(n => ({ ...n, read: true })));
    }
  };

  const deleteNotification = (id) => {
    if (setNotifications) {
      try {
        const deletedIds = JSON.parse(localStorage.getItem('success_empire_deleted_notif_ids') || '[]');
        const strId = id.toString();
        if (!deletedIds.includes(id)) deletedIds.push(id);
        if (!deletedIds.includes(strId)) deletedIds.push(strId);
        localStorage.setItem('success_empire_deleted_notif_ids', JSON.stringify(deletedIds));
      } catch (e) {
        console.error(e);
      }
      setNotifications(prev => prev.filter(n => n.id !== id && n.id.toString() !== id.toString()));
    }
  };

  const markAsRead = (id) => {
