                      s === 'standard' ? 2000000000004 :
                      s === 'supreme' ? 2000000000001 :
                      s === 'premium' ? 2000000000002 :
                      s === 'premium_plus' ? 2000000000003 :
                      Number(packageId) || 0;
    const pkg = (PACKAGES || []).find(p => p && Number(p.id) === numericId);
    if (pkg && pkg.price !== undefined) return pkg.price;
    if (s === 'creator' || s === 'standard') return 3999;
    if (s === 'supreme') return 4000;
    if (s === 'premium') return 6000;
