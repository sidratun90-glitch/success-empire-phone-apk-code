            <div className="absolute -top-10 -left-10 w-24 h-24 bg-amber-500/10 rounded-full blur-xl"></div>
            <div className="absolute -bottom-10 -right-10 w-24 h-24 bg-indigo-500/10 rounded-full blur-xl"></div>

            <div className="w-16 h-16 bg-amber-500/10 rounded-full flex items-center justify-center mb-4 border border-amber-500/20 shadow-[0_0_30px_rgba(245,158,11,0.2)] animate-pulse">
              <Shield size={32} className="text-amber-500" />
            </div>

            <h3 className="text-white font-extrabold text-lg mb-2 tracking-wide uppercase">Image Size Alert!</h3>
            <p className="text-gray-300 text-xs leading-relaxed mb-6 px-2">
              App branding logo ka size <strong className="text-amber-400">100 KB</strong> se kam hona chahiye taaki sabhi students ke slow internet connection par bhi logo instantly load ho sake.
            </p>

            <button
              onClick={() => setSizeWarningModal(false)}
              className="w-full py-3 bg-gradient-to-r from-amber-500 to-orange-600 text-slate-950 font-black text-xs rounded-xl shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:scale-[1.02] active:scale-95 transition-all uppercase tracking-wider"
            >
              Thik Hai, Understood
            </button>
          </div>
        </div>
      )}
    </div>
  );
};

