      missingVideoUrls: 0,
      missingThumbnails: 0,
      invalidRecords: 0,
      errors: [],
      warnings: [],
      cloudinaryAssetCount: 0
    };

    if (!backupData || typeof backupData !== 'object') {
      report.errors.push("Invalid backup file: Format must be a JSON object.");
      return report;
    }

    const { packages, settings, coupons, purchase_records, certificates, recovery_logs, users, notifications, certificate_applications, backupMeta } = backupData;

    if (!packages || !Array.isArray(packages)) {
      report.errors.push("Invalid backup: Missing 'packages' array.");
    }
    if (!settings || typeof settings !== 'object') {
      report.errors.push("Invalid backup: Missing 'settings' configuration.");
    }

    if (report.errors.length > 0) return report;

    if (backupMeta && backupMeta.integrityHash) {
      try {
        const dataToHash = JSON.stringify({
          packages,
          settings,
          coupons: coupons || [],
          purchase_records: purchase_records || [],
          certificates: certificates || [],
          recovery_logs: recovery_logs || [],
          users: users || [],
          notifications: notifications || [],
          certificate_applications: certificate_applications || []
        });
        const computedHash = await computeSHA256(dataToHash);
        if (computedHash === backupMeta.integrityHash) {
          report.isValid = true;
        } else {
          report.errors.push(`SHA256 Checksum Mismatch! Data may be corrupted or modified.`);
        }
      } catch (e) {
        report.errors.push("Failed to verify SHA256 integrity hash: " + e.message);
      }
    } else {
      report.warnings.push("No SHA256 integrity hash found in backup metadata. Integrity cannot be verified.");
