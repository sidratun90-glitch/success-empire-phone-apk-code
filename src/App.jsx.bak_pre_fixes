                  <circle
                    className={`${healthScore >= 90 ? 'text-emerald-500' : healthScore >= 70 ? 'text-yellow-500' : 'text-red-500'
                      } transition-all duration-1000`}
                    strokeWidth="8"
                    strokeDasharray={2 * Math.PI * 38}
                    strokeDashoffset={2 * Math.PI * 38 * (1 - healthScore / 100)}
