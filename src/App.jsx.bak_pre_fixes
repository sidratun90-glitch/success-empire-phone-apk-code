const ExploreScreen = React.memo(({ navigateTo, purchasedPackages, isLoading, isRefreshing, completedLessons, playbackProgress }) => {
  const courseProgressMap = React.useMemo(() => {
    const map = {};
    if (!completedLessons || completedLessons.length === 0) return map;
    const courseLessonsCount = {};
    const courseCompletedCount = {};
    (PACKAGES || []).forEach(p => {
      if (!p || !p.lessons) return;
      p.lessons.forEach(l => {
        if (!l || !l.courseName) return;
        const cName = l.courseName;
        courseLessonsCount[cName] = (courseLessonsCount[cName] || 0) + 1;
        if (completedLessons.includes(l.id)) {
          courseCompletedCount[cName] = (courseCompletedCount[cName] || 0) + 1;
        }
      });
    });
    Object.keys(courseLessonsCount).forEach(cName => {
      const total = courseLessonsCount[cName];
      const completed = courseCompletedCount[cName] || 0;
      map[cName] = total > 0 ? Math.round((completed / total) * 100) : 0;
    });
    return map;
  }, [completedLessons]);

  const renderSkeletons = () => {
    return Array.from({ length: 4 }).map((_, idx) => (
      <div key={`sk-${idx}`} className="flex flex-col gap-1 w-full animate-pulse">
        <div className="bg-gray-200 rounded-2xl aspect-video border border-gray-150 relative"></div>
        <div className="h-3 bg-gray-200 rounded w-3/4 mx-auto mt-1"></div>
      </div>
    ));
  };

  const isDataLoading = isLoading || (PACKAGES || []).length === 0;

  const [searchQuery, setSearchQuery] = useState("");
  const [selectedLanguage, setSelectedLanguage] = useState("All");
  const [showFilter, setShowFilter] = useState(false);
  const filterLanguages = ["All", "Hindi", "English", "Tamil", "Telugu", "Kannada"];
  const [toastMsg, setToastMsg] = useState("");

  const showToast = (msg) => {
    setToastMsg(msg);
  };

  const allCoursePlaylists = React.useMemo(() => {
    const playlists = [];
    (PACKAGES || []).forEach(pkg => {
      if (!pkg) return;
      const isPurchased = (purchasedPackages || []).includes(pkg.id);
      const lessonsList = pkg.lessons || [];

      const grouped = lessonsList.reduce((acc, lesson) => {
        if (!lesson) return acc;
        const cName = lesson.courseName || "General Content";
        if (!acc[cName]) acc[cName] = [];
        acc[cName].push(lesson);
        return acc;
      }, {});

      Object.entries(grouped).forEach(([cName, lessons]) => {
        if (!lessons || lessons.length === 0) return;
        const customCover = pkg.courseCovers?.[cName];
        const coverImage = customCover ? resolveLocalThumbnail(customCover) : (resolveLocalThumbnail(lessons[0]?.thumbnail) || "");
        const isLocked = !isPurchased && lessons.some(l => l && l.isLocked);
        const isComingSoon = lessons.some(l => l && l.isComingSoon);

        playlists.push({
          id: `${pkg.id}-${cName}`,
          courseName: cName,
          packageId: pkg.id,
          packageName: pkg.title || "",
          thumbnail: coverImage,
          videoCount: lessons.length,
          isLocked: isLocked,
          isPurchased: isPurchased,
          isComingSoon: isComingSoon,
          language: lessons[0]?.language || pkg.language || "Hindi"
        });
      });
    });
    return playlists;
  }, [purchasedPackages, isLoading, isRefreshing]);

  const filteredCourses = React.useMemo(() => {
    return (allCoursePlaylists || []).filter(course => {
      if (!course) return false;
      const cName = course.courseName || "";
      const pName = course.packageName || "";
      const matchesSearch = cName.toLowerCase().includes(searchQuery.toLowerCase()) ||
        pName.toLowerCase().includes(searchQuery.toLowerCase());
      const matchesLanguage = selectedLanguage === "All" || course.language === selectedLanguage;
      return matchesSearch && matchesLanguage;
    });
  }, [allCoursePlaylists, searchQuery, selectedLanguage]);

  return (
    <div className="flex flex-col h-full bg-white pb-24 overflow-y-auto hide-scrollbar relative">
      <PremiumToast msg={toastMsg} onClose={() => setToastMsg("")} />

      <header className="px-5 pt-header-safe pb-4 z-10 sticky top-0 bg-white/90 backdrop-blur-md border-b border-gray-100">
        <h1 className="text-xl font-bold text-gray-900 mb-4">Explore All Courses</h1>
        <div className="flex gap-2 relative">
          <div className="relative flex-1">
            <Search className="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400" size={18} />
            <input
              type="text"
              placeholder="Search course or topic..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-gray-50 border border-gray-250 rounded-2xl pl-10 pr-4 py-3 text-sm text-gray-900 outline-none focus:border-purple-500 transition-colors placeholder-gray-400 h-[46px]"
            />
          </div>
          <button onClick={() => setShowFilter(!showFilter)} className={`w-[46px] h-[46px] rounded-2xl flex items-center justify-center border transition-all ${selectedLanguage !== "All" || showFilter ? "bg-purple-50 border-purple-200 text-purple-600" : "bg-white border-gray-255 text-gray-500 hover:bg-gray-50"}`}><Languages size={18} /></button>
          {showFilter && (
            <div className="absolute top-14 right-0 w-44 bg-white border border-gray-200 rounded-xl p-3 shadow-xl z-50 animate-fade-in">
              <h3 className="text-gray-800 text-xs font-bold mb-2 pb-2 border-b border-gray-100">Select Language</h3>
              <div className="flex flex-col gap-1">
                {filterLanguages.map(lang => (
                  <button key={lang} onClick={() => { setSelectedLanguage(lang); setShowFilter(false); }} className={`text-left px-3 py-2 rounded-lg text-sm transition-colors ${selectedLanguage === lang ? 'bg-purple-600 text-white font-bold' : 'text-gray-600 hover:bg-gray-50'}`}>{lang === "All" ? "All Languages" : lang}</button>
                ))}
              </div>
            </div>
          )}
        </div>
      </header>

      {isDataLoading && !isRefreshing && (
        <div className="px-5 mt-4">
          <div className="p-3 bg-amber-500/10 border border-amber-500/20 rounded-2xl flex items-center gap-2.5 text-amber-600 animate-pulse">
            <span className="flex-shrink-0 w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
            <span className="text-[11px] font-black tracking-wide uppercase">Your network connection is slow.</span>
          </div>
        </div>
      )}

      <div className="px-5 mt-4 grid grid-cols-2 gap-3 sm:gap-4 animate-fade-in">
        {isDataLoading ? (
          renderSkeletons()
        ) : filteredCourses.length > 0 ? (
          filteredCourses.map(course => {
            const comingSoon = course.isComingSoon;
            const targetPkg = PACKAGES.find(p => String(p.id) === String(course.packageId));
            const courseLessons = targetPkg?.lessons?.filter(l => l.courseName === course.courseName) || [];
            const isPurchased = purchasedPackages && purchasedPackages.some(pId => String(pId) === String(course.packageId));
            const isCourseLocked = !isPurchased && courseLessons.length > 0 && courseLessons.every(l => l.isLocked);
            const firstUnlocked = courseLessons.find(l => !l.isLocked);
            const targetLessonId = isPurchased
              ? (getContinueLessonId(courseLessons, completedLessons, playbackProgress) || course.lessonId)
              : (firstUnlocked?.id || course.lessonId);
            const courseProgress = courseProgressMap[course.courseName] || 0;
            return (
              <div key={course.id} className="flex flex-col gap-1 w-full" onClick={() => {
                if (comingSoon) {
                  showToast(`${course.courseName} जल्द आ रहा है!`);
                } else if (isCourseLocked) {
                  showToast("पहले कोर्स परचेस करना पड़ेगा");
                } else {
                  navigateTo('player', course.packageId, targetLessonId);
                }
              }}>
                <div className="bg-white rounded-2xl overflow-hidden cursor-pointer shadow-sm aspect-video border border-gray-150 relative group">
                  <div className="absolute inset-0 border-t border-white/30 rounded-2xl pointer-events-none z-10" />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none z-10" />
                  <img src={course.thumbnail} alt={course.courseName} className="w-full h-full object-cover" />

                  {comingSoon && (
                    <div className="absolute inset-0 flex items-center justify-center bg-black/50">
                      <span className="text-[10px] font-bold uppercase tracking-widest text-white bg-amber-500/90 px-2 py-1 rounded-full shadow-md flex items-center gap-1"><Clock size={10} /> Soon</span>
                    </div>
                  )}
                  {!comingSoon && !isCourseLocked && courseProgress > 0 && (
                    <div className="absolute bottom-0 left-0 w-full h-1 bg-black/40 z-20">
                      <div
                        style={{ width: `${courseProgress}%` }}
                        className="h-full bg-gradient-to-r from-purple-500 to-indigo-600"
                      />
                    </div>
                  )}
                </div>
                <div className="text-[11px] font-bold text-gray-800 line-clamp-1 truncate px-1 mt-0.5 text-center flex items-center justify-center gap-1">
                  <span>{course.courseName}</span>
                  {!comingSoon && !isCourseLocked && courseProgress > 0 && (
                    <span className="text-[9px] text-purple-600 font-extrabold">({courseProgress}%)</span>
                  )}
                </div>
              </div>
            );
          })
        ) : (
          <div className="col-span-2 text-center text-gray-400 mt-10">
            <Search size={40} className="mx-auto mb-3 opacity-20" />
            <p className="text-sm font-medium">No courses found...</p>
            <p className="text-[10px] mt-1">Try other keywords.</p>
          </div>
        )}
      </div>
    </div>
  );
});

