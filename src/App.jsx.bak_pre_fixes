      throw new Error("Cannot restore: SHA256 integrity hash verification failed.");
    }

    if (isDryRun) {
      return { success: true, report, message: "Dry Run verification passed successfully! No data was overwritten." };
    }

    setIsRestoring(true);
    try {
      const { packages, settings, coupons, purchase_records, certificates, recovery_logs, users, notifications, certificate_applications } = backupData;

      if (mode === 'course' || mode === 'full') {
        for (const pkg of packages) {
          await setDoc(doc(db, "packages", pkg.id.toString()), pkg);
        }
