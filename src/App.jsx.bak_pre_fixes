const getHighestActivePackage = (pkgsList) => {
  if (!pkgsList || pkgsList.length === 0) return null;
  const directSet = new Set(pkgsList.map(id => mapPackageId(id)));
  let highestPkgId = null;
  let maxLevel = -1;

  (PACKAGES || []).forEach(pkg => {
    if (directSet.has(mapPackageId(pkg.id))) {
      const lvl = Number(pkg.level) || 0;
      if (lvl > maxLevel) {
        maxLevel = lvl;
        highestPkgId = pkg.id;
      }
    }
  });

  return highestPkgId || pkgsList[0] || null;
};

const resolvePackageStatus = (pkg, directPurchasedPackages = [], effectivePurchasedPackages = [], grantedAccess = false, grantedPackage = "") => {
  const isDirect = (directPurchasedPackages || []).map(id => mapPackageId(id)).includes(mapPackageId(pkg.id)) ||
    (grantedAccess && (mapPackageId(grantedPackage) === mapPackageId(pkg.id) || grantedPackage === 'all_courses'));

  if (isDirect) return "Purchased";

  const hasAccess = (effectivePurchasedPackages || []).map(id => String(id)).includes(String(pkg.id));
  if (hasAccess) return "Free";

  const hasAnyAccess = (effectivePurchasedPackages || []).length > 0;
  if (hasAnyAccess) {
    return "Upgrade Available";
  }

  return "Locked";
};

const getPackageDisplayPrice = (pkg, status, isUpgradeEligible, activePkgPrice) => {
  if (status === "Free" || status === "Free Included") return "Free";
  if (status === "Purchased") return "Owned";
  if (status === "Upgrade Available") {
    if (isUpgradeEligible) {
      return Math.max(0, pkg.price - activePkgPrice);
    }
  }
  return pkg.price;
};

