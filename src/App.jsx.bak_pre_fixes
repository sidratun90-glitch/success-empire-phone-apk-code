const PremiumBannerCarousel = ({ sortedPosters, activeIndex, setActiveIndex, isPaused, setIsPaused }) => {
  const N = sortedPosters.length;
  if (N === 0) return null;

  const extendedPosters = React.useMemo(() => {
    if (N === 1) return sortedPosters;
    return [sortedPosters[N - 1], ...sortedPosters, sortedPosters[0]];
  }, [sortedPosters, N]);

  const isSingle = N === 1;

  const [currentIndex, setCurrentIndex] = React.useState(isSingle ? 0 : activeIndex + 1);
  const [disableTransition, setDisableTransition] = React.useState(false);
  const [dragOffset, setDragOffset] = React.useState(0);
  const dragRef = React.useRef({ startX: 0, isDragging: false });
  const [config, setConfig] = React.useState({ widthPercent: 72, gapPx: 16, trackAspect: '16/9.2' });

  React.useEffect(() => {
    const handleResize = () => {
      const w = window.innerWidth;
      if (w >= 1024) {
        setConfig({ widthPercent: 44, gapPx: 24, trackAspect: '16/6.2' });
      } else if (w >= 768) {
        setConfig({ widthPercent: 54, gapPx: 20, trackAspect: '16/7.2' });
      } else if (w >= 640) {
        setConfig({ widthPercent: 64, gapPx: 16, trackAspect: '16/8.2' });
      } else {
        setConfig({ widthPercent: 72, gapPx: 16, trackAspect: '16/9.2' });
      }
    };
    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // Sync parent's activeIndex changes to local currentIndex
  React.useEffect(() => {
    if (isSingle) return;

    let targetIndex = activeIndex + 1;

    // Handle infinite loop edge wrap-around direction
    if (activeIndex === 0 && currentIndex === N) {
      targetIndex = N + 1;
    } else if (activeIndex === N - 1 && currentIndex === 1) {
      targetIndex = 0;
    }

    if (currentIndex !== targetIndex) {
      if (currentIndex === 0 || currentIndex === N + 1) return;
      setCurrentIndex(targetIndex);
    }
  }, [activeIndex, N, isSingle, currentIndex]);

  // Clean transition disabling effect
  React.useEffect(() => {
    if (disableTransition) {
      const timer = setTimeout(() => {
        setDisableTransition(false);
      }, 50);
      return () => clearTimeout(timer);
    }
  }, [disableTransition]);

  const handleTransitionEnd = () => {
    if (isSingle) return;
    if (currentIndex === 0) {
      setDisableTransition(true);
      setCurrentIndex(N);
    } else if (currentIndex === N + 1) {
      setDisableTransition(true);
      setCurrentIndex(1);
    }
  };

  const handleStart = (clientX) => {
    if (isSingle) return;
    setIsPaused(true);
    dragRef.current = {
      startX: clientX,
      isDragging: true
    };
  };

  const handleMove = (clientX) => {
    if (!dragRef.current.isDragging) return;
    const diff = clientX - dragRef.current.startX;
    setDragOffset(diff);
  };

  const handleEnd = () => {
    if (!dragRef.current.isDragging) return;
    dragRef.current.isDragging = false;
    const finalOffset = dragOffset;
    setDragOffset(0);
    setIsPaused(false);

    const threshold = 50;
    let nextIndex = currentIndex;
    if (finalOffset < -threshold) {
      nextIndex = currentIndex + 1;
    } else if (finalOffset > threshold) {
      nextIndex = currentIndex - 1;
    } else {
      return;
    }

    setCurrentIndex(nextIndex);

    let parentIndex = nextIndex - 1;
    if (parentIndex < 0) {
      parentIndex = N - 1;
    } else if (parentIndex >= N) {
      parentIndex = 0;
    }
    setActiveIndex(parentIndex);
  };

  const wPercent = config.widthPercent;
  const gapPx = config.gapPx;

  const translationCSS = isSingle
    ? '0px'
    : `calc(50% - ${wPercent / 2}% - ${currentIndex * wPercent}% - ${currentIndex * gapPx}px + ${dragOffset}px)`;

  const transitionStyle = disableTransition || dragRef.current.isDragging
    ? 'none'
    : 'transform 600ms cubic-bezier(0.25, 1, 0.5, 1)';

  return (
    <div
      className="w-full relative overflow-hidden select-none py-6 mt-2 animate-fade-in"
      style={{
        aspectRatio: config.trackAspect
      }}
      onMouseEnter={() => setIsPaused(true)}
      onMouseLeave={() => {
        setIsPaused(false);
        if (dragRef.current.isDragging) {
          handleEnd();
        }
      }}
      onTouchStart={(e) => handleStart(e.touches[0].clientX)}
      onTouchMove={(e) => handleMove(e.touches[0].clientX)}
      onTouchEnd={handleEnd}
      onMouseDown={(e) => handleStart(e.clientX)}
      onMouseMove={(e) => handleMove(e.clientX)}
      onMouseUp={handleEnd}
    >
      <div
        className="flex items-center w-full h-full"
        style={{
          transform: `translateX(${translationCSS})`,
          transition: transitionStyle,
          gap: `${gapPx}px`
        }}
        onTransitionEnd={handleTransitionEnd}
      >
        {extendedPosters.map((poster, idx) => {
          const isCenter = isSingle ? true : idx === currentIndex;
          return (
            <div
              key={`${poster.id}-${idx}`}
              className="flex-shrink-0 relative rounded-2xl overflow-hidden shadow-lg transition-all duration-600 ease-[cubic-bezier(0.25,1,0.5,1)]"
              style={{
                width: `${wPercent}%`,
                aspectRatio: '16/9',
                transform: `scale(${isCenter ? 1.04 : 0.92}) translateY(${isCenter ? '0px' : '14px'})`,
                opacity: isCenter ? 1.0 : 0.65,
                zIndex: isCenter ? 10 : 1,
                boxShadow: isCenter ? '0 20px 40px -15px rgba(0,0,0,0.3)' : '0 8px 16px -8px rgba(0,0,0,0.2)'
              }}
            >
              <img
                src={poster.image}
                alt="Course Poster"
                className="w-full h-full object-cover pointer-events-none"
              />
              <div className="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/10 pointer-events-none" />
            </div>
          );
        })}
      </div>


    </div>
  );
};

