class ErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false, error: null };
  }

  static getDerivedStateFromError(error) {
    return { hasError: true, error };
  }

  componentDidCatch(error, errorInfo) {
    console.error("ErrorBoundary caught an error:", error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return (
        <div className="p-6 bg-rose-950/20 border border-rose-500/30 rounded-2xl text-center backdrop-blur-xl m-4 animate-fade-in">
          <div className="w-12 h-12 bg-rose-500/20 rounded-full flex items-center justify-center mx-auto mb-3 text-rose-400">
            <AlertTriangle size={24} className="animate-pulse" />
          </div>
          <h3 className="text-white text-sm font-bold mb-1">Section Load Failed</h3>
          <p className="text-rose-200 text-[10px] leading-relaxed max-w-xs mx-auto mb-3 font-medium">
            {this.state.error?.message || "Something went wrong in this component."}
          </p>
          <button
            onClick={() => this.setState({ hasError: false, error: null })}
            className="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-[10px] font-bold shadow-lg shadow-rose-600/20 transition-all active:scale-95"
          >
            Retry Loading
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}

const parseExpiryTime = (expiryDate) => {
  if (!expiryDate) return null;
  if (typeof expiryDate === 'number') return expiryDate;
  if (typeof expiryDate.toDate === 'function') {
    try {
      return expiryDate.toDate().getTime();
    } catch (e) {
      console.error("Error converting Firestore Timestamp:", e);
    }
  }
  if (expiryDate instanceof Date) return expiryDate.getTime();
  if (typeof expiryDate === 'string') {
    const parsed = new Date(expiryDate).getTime();
    return isNaN(parsed) ? null : parsed;
  }
  if (expiryDate && typeof expiryDate === 'object' && expiryDate.seconds !== undefined) {
    return expiryDate.seconds * 1000;
  }
  return null;
};

const isGrantExpiryActive = (grantedAccess, expiryDate) => {
  if (!grantedAccess) return false;
  if (!expiryDate) return true; // Lifetime access
  const time = parseExpiryTime(expiryDate);
  return time ? time > Date.now() : true;
};

const safeFormatDate = (timestamp) => {
  if (!timestamp) return 'N/A';
  try {
    let dateVal;
    if (typeof timestamp === 'number') {
      dateVal = new Date(timestamp);
    } else if (typeof timestamp.toDate === 'function') {
      dateVal = timestamp.toDate();
    } else if (timestamp && typeof timestamp === 'object' && timestamp.seconds !== undefined) {
      dateVal = new Date(timestamp.seconds * 1000);
    } else {
      dateVal = new Date(timestamp);
    }
    if (isNaN(dateVal.getTime())) return 'N/A';
    return dateVal.toLocaleString();
  } catch (e) {
    return 'N/A';
  }
};

