const getContinueLessonId = (lessons, completedLessons, playbackProgress) => {
  if (!lessons || lessons.length === 0) return null;
  const completedList = Array.isArray(completedLessons) ? completedLessons : [];

  // 1. Find the first lesson that has playback progress (is partially completed) but is NOT marked as completed
  const partiallyCompleted = lessons.find(l => {
    if (!l) return false;
    const isCompleted = completedList.includes(l.id);
    const progress = playbackProgress && playbackProgress[String(l.id)];
    return !isCompleted && progress && progress.position > 5;
  });
  if (partiallyCompleted) return partiallyCompleted.id;

  // 2. Find the first lesson that is NOT completed
  const uncompleted = lessons.find(l => l && !completedList.includes(l.id));
  if (uncompleted) return uncompleted.id;

  // 3. Default to the first lesson if all are completed
  return lessons[0]?.id || null;
};

