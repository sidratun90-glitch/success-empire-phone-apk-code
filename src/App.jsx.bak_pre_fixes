                  message += `\n- *Upgrade Credit:* -₹${formatPrice(upgradeAdjustment)}`;
                }
                message += `\n- *Price Paid:* ₹${formatPrice(finalPrice)}`;
                message += `\n- *Name:* ${nameText}`;
                message += `\n- *Email:* ${emailText}`;
                if (screenshotLink) {
                  message += `\n- *Receipt Link:* ${screenshotLink}`;
                }
                message += `\n\n(Maine payment screenshot clipboard par copy kar liya hai aur yahan message ke sath paste kar raha hoon. Please verification check karke approve karein!)`;

                const encodedMessage = encodeURIComponent(message);
                const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
                window.open(whatsappUrl, '_blank');
              }}
              className="w-full py-4 bg-green-600 hover:bg-green-700 text-white font-extrabold rounded-xl shadow-lg active:scale-95 transition-transform text-xs uppercase tracking-wider mt-4 flex items-center justify-center gap-2"
