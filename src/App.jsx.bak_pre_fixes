            ? "bg-red-600 text-white shadow-md shadow-red-600/20"
            : "text-gray-400 hover:text-white"
            }`}
        >
          <Plus size={13} /> Create
        </button>
        <button
          onClick={() => setActiveSubTab("emergency")}
          className={`flex-1 py-2 rounded-lg text-xs font-black transition-all flex items-center justify-center gap-1.5 ${activeSubTab === "emergency"
            ? "bg-red-600 text-white shadow-md shadow-red-600/20"
            : "text-gray-400 hover:text-white"
            }`}
        >
          <AlertTriangle size={13} /> Emergency
        </button>
        <button
          onClick={() => setActiveSubTab("history")}
          className={`flex-1 py-2 rounded-lg text-xs font-black transition-all flex items-center justify-center gap-1.5 ${activeSubTab === "history"
            ? "bg-red-600 text-white shadow-md shadow-red-600/20"
            : "text-gray-400 hover:text-white"
            }`}
        >
          <Clock size={13} /> History
        </button>
      </div>

      {/* Tab Content */}
      <div className="space-y-6">
        {activeSubTab === "overview" && (
          <div className="space-y-4 animate-fade-in">
            <div className="bg-white/5 border border-white/10 p-6 rounded-2xl relative overflow-hidden backdrop-blur-md flex flex-col items-center justify-center text-center">
              <div className="absolute top-0 right-0 w-24 h-24 bg-red-500/5 rounded-full blur-2xl"></div>
              <span className="text-gray-400 text-[10px] uppercase font-bold tracking-widest mb-3">Database Health Integrity</span>
              <div className="relative w-28 h-28 flex items-center justify-center mb-4">
