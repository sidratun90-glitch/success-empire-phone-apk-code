const BackupRecoveryView = ({
  goBack,
  backupHistory,
  fetchCurrentDatabaseMetrics,
  createBackupSnapshot,
  showToast,
  restorePreviewData,
  setRestorePreviewData,
  currentDbMetrics,
  setCurrentDbMetrics,
  restoreMode,
  setRestoreMode,
  setDryRunResult,
  isRestoring,
  restoreBackup,
  toggleBackupLock,
  downloadBackupFiles,
  createBackupPayload
}) => {
  const [manualLabel, setManualLabel] = useState("");
  const [manualCategory, setManualCategory] = useState("manual");
  const [confirmDeleteText, setConfirmDeleteText] = useState("");
  const [backupToDeleteId, setBackupToDeleteId] = useState(null);
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [dryRunBanner, setDryRunBanner] = useState(null);
  const [isCreating, setIsCreating] = useState(false);
  const [isExporting, setIsExporting] = useState(false);
  const [dbStats, setDbStats] = useState(null);
  const [activeSubTab, setActiveSubTab] = useState("overview");

  const handleDirectExportClick = async () => {
    if (isExporting) return;
    setIsExporting(true);
    try {
      const payload = await createBackupPayload("manual", "Direct Export");
      downloadBackupFiles(payload);
      showToast("Backup exported and downloaded successfully! 📥");
    } catch (e) {
      alert("Direct Export failed: " + e.message);
    } finally {
      setIsExporting(false);
    }
  };

  useEffect(() => {
    let active = true;
    fetchCurrentDatabaseMetrics().then(res => {
      if (active && res) setDbStats(res);
    });
    return () => { active = false; };
  }, [backupHistory]);

  const handleFileUpload = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = async (event) => {
      try {
        const parsed = JSON.parse(event.target.result);
        setRestorePreviewData(parsed);
        const metrics = await fetchCurrentDatabaseMetrics();
        setCurrentDbMetrics(metrics);
        setDryRunResult(null);
        setDryRunBanner(null);
        showToast("Backup JSON file parsed & verified! 📄");
      } catch (err) {
        alert("Invalid backup file: " + err.message);
      }
    };
    reader.readAsText(file);
  };

  const handleCreateSnapshotClick = async () => {
    if (isCreating) return;
    setIsCreating(true);
    try {
      const lbl = manualLabel.trim() || `${manualCategory === 'golden' ? 'Golden' : 'Manual'} Backup Created on ${new Date().toLocaleString()}`;
      await createBackupSnapshot(manualCategory, lbl);
      setManualLabel("");
      showToast("Backup snapshot created successfully! 💾");
    } catch (e) {
      showToast("Failed: " + e.message);
    } finally {
      setIsCreating(false);
    }
  };

  const handleDeleteClick = (backup) => {
    if (backup.isLocked) {
      showToast("Cannot delete a locked backup!");
      return;
    }
    setBackupToDeleteId(backup.id);
    setConfirmDeleteText("");
    setShowDeleteModal(true);
  };

  const executeDeleteBackup = async () => {
    const target = backupHistory.find(b => b.id === backupToDeleteId);
    if (!target) return;

    if (target.category === 'golden') {
      if (confirmDeleteText !== 'CONFIRM') {
        showToast("Validation failed: Please type CONFIRM exactly.");
        return;
      }
    }

    try {
      await deleteDoc(doc(db, "backups", backupToDeleteId));
      showToast("Backup deleted successfully! 🗑️");
      setShowDeleteModal(false);
      setBackupToDeleteId(null);
    } catch (e) {
      showToast("Failed: " + e.message);
    }
  };

  const triggerEmergencyRestore = async (category) => {
    const filtered = backupHistory.filter(b => b.category === category);
    if (filtered.length === 0) {
      showToast(`No backup found in category: ${category}`);
      return;
    }
    const latest = filtered[0];
    if (latest.storedOffline) {
      showToast("This backup is stored offline (size >= 1MB). Please upload the downloaded JSON file.");
      return;
    }
    try {
      const data = typeof latest.data === 'string' ? JSON.parse(latest.data) : latest.data;
      setRestorePreviewData(data);
      const metrics = await fetchCurrentDatabaseMetrics();
      setCurrentDbMetrics(metrics);
      setDryRunResult(null);
      setDryRunBanner(null);
      showToast("Emergency backup selected. Please preview before restoring.");
    } catch (e) {
      showToast("Failed to load emergency backup: " + e.message);
    }
  };

  let healthScore = 100;
  let missingVideos = 0;
  let missingThumbs = 0;
  if (dbStats) {
    let totalLessons = 0;
    let totalVideos = 0;
    let localMissingVideos = 0;
    let localMissingThumbs = 0;
    PACKAGES.forEach(pkg => {
      if (!pkg.thumbnail) {
        console.log("Integrity check: pkg missing thumbnail details:", JSON.stringify(pkg));
        localMissingThumbs++;
      }
      (pkg.lessons || []).forEach(l => {
        totalLessons++;
        if (!l.thumbnail) {
          console.log("Integrity check: lesson missing thumbnail details:", JSON.stringify(l), "in pkg:", JSON.stringify(pkg));
          localMissingThumbs++;
        }
        const hasVideo = l.videoUrl || (l.videoUrls && Object.values(l.videoUrls).some(url => !!url));
        if (hasVideo) totalVideos++;
        else localMissingVideos++;
      });
    });
    missingVideos = localMissingVideos;
    missingThumbs = localMissingThumbs;

    healthScore -= (localMissingVideos * 5);
    healthScore -= (localMissingThumbs * 2);
    healthScore = Math.max(0, Math.min(100, healthScore));
