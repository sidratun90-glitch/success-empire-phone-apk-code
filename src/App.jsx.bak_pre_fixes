const ImageCropperModal = ({ imageSrc, aspectRatio, onCrop, onCancel }) => {
  const [scale, setScale] = useState(1.2);
  const [position, setPosition] = useState({ x: 0, y: 0 });
  const [isDragging, setIsDragging] = useState(false);
  const [dragStart, setDragStart] = useState({ x: 0, y: 0 });
  const [imgDims, setImgDims] = useState({ naturalWidth: 0, naturalHeight: 0 });
  const imgRef = useRef(null);

  const handleMouseDown = (e) => {
    setIsDragging(true);
    setDragStart({ x: e.clientX - position.x, y: e.clientY - position.y });
  };

  const handleMouseMove = (e) => {
    if (!isDragging) return;
    setPosition({
      x: e.clientX - dragStart.x,
      y: e.clientY - dragStart.y
    });
  };

  const handleMouseUp = () => {
    setIsDragging(false);
  };

  const handleTouchStart = (e) => {
    if (e.touches.length !== 1) return;
    setIsDragging(true);
    setDragStart({
      x: e.touches[0].clientX - position.x,
      y: e.touches[0].clientY - position.y
    });
  };

  const handleTouchMove = (e) => {
    if (!isDragging || e.touches.length !== 1) return;
    setPosition({
      x: e.touches[0].clientX - dragStart.x,
      y: e.touches[0].clientY - dragStart.y
    });
  };

  const handleImageLoad = (e) => {
    setImgDims({
      naturalWidth: e.target.naturalWidth,
      naturalHeight: e.target.naturalHeight
    });
  };

  const containerWidth = 300;
  const containerHeight = 300 / aspectRatio;

  const naturalWidth = imgDims.naturalWidth || 300;
  const naturalHeight = imgDims.naturalHeight || (300 / aspectRatio);

  const imgVisualHeight = containerHeight;
  const imgVisualWidth = (naturalWidth / naturalHeight) * containerHeight;

  const handleCrop = () => {
    const canvas = document.createElement('canvas');
    const img = imgRef.current;
    if (!img || !imgDims.naturalWidth) return;

    const width = aspectRatio === 16 / 9 ? 1280 : aspectRatio === 1 / 1 ? 512 : 720;
    const height = aspectRatio === 16 / 9 ? 720 : aspectRatio === 1 / 1 ? 512 : 1280;
    canvas.width = width;
    canvas.height = height;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, width, height);

    ctx.save();

    const scaleFactor = width / containerWidth;

    ctx.translate(width / 2, height / 2);
    ctx.translate(position.x * scaleFactor, position.y * scaleFactor);
    ctx.scale(scale * scaleFactor, scale * scaleFactor);

    ctx.drawImage(
      img,
      -imgVisualWidth / 2,
      -imgVisualHeight / 2,
      imgVisualWidth,
      imgVisualHeight
    );

    ctx.restore();

    canvas.toBlob((blob) => {
      if (blob) {
        const croppedFile = new File([blob], 'cropped_image.jpg', { type: 'image/jpeg' });
        onCrop(croppedFile);
      }
    }, 'image/jpeg', 0.85);
  };

  return (
    <div className="fixed inset-0 z-[200] flex flex-col items-center justify-center bg-black/90 backdrop-blur-md px-4 animate-fade-in">
      <div className="bg-slate-900 border border-white/10 p-5 rounded-3xl w-full max-w-sm shadow-[0_20px_50px_rgba(0,0,0,0.8)] text-center flex flex-col">
        <h3 className="text-white font-black text-base mb-2">Adjust & Crop Image</h3>
        <p className="text-gray-400 text-[10px] mb-4">Drag to position, use the slider below to zoom</p>

        <div
          className="relative overflow-hidden bg-black border border-white/10 rounded-2xl mx-auto flex items-center justify-center cursor-move"
          style={{
            width: '300px',
            height: aspectRatio === 16 / 9 ? '169px' : aspectRatio === 1 / 1 ? '300px' : '300px',
          }}
          onMouseDown={handleMouseDown}
          onMouseMove={handleMouseMove}
          onMouseUp={handleMouseUp}
          onMouseLeave={handleMouseUp}
          onTouchStart={handleTouchStart}
          onTouchMove={handleTouchMove}
          onTouchEnd={handleMouseUp}
        >
          <img
            ref={imgRef}
            src={imageSrc}
            alt="Crop preview"
            draggable="false"
            onLoad={handleImageLoad}
            className="absolute max-w-none origin-center pointer-events-none select-none"
            style={{
              width: `${imgVisualWidth}px`,
              height: `${imgVisualHeight}px`,
              transform: `translate(${position.x}px, ${position.y}px) scale(${scale})`,
              transition: isDragging ? 'none' : 'transform 0.1s ease-out',
            }}
          />
          <div className="absolute inset-0 border border-purple-500/30 pointer-events-none flex flex-col justify-between">
            <div className="w-full h-px bg-white/20 mt-[33%]"></div>
            <div className="w-full h-px bg-white/20 mb-[33%]"></div>
          </div>
          <div className="absolute inset-0 pointer-events-none flex justify-between">
            <div className="h-full w-px bg-white/20 ml-[33%]"></div>
            <div className="h-full w-px bg-white/20 mr-[33%]"></div>
          </div>
        </div>

        <div className="mt-5 mb-6 px-2">
          <div className="flex justify-between text-[10px] text-gray-400 font-medium mb-1">
            <span>Zoom Out</span>
            <span>Zoom In</span>
          </div>
          <input
            type="range"
            min="0.5"
            max="3"
            step="0.05"
            value={scale}
            onChange={(e) => setScale(parseFloat(e.target.value))}
            className="w-full accent-purple-500 cursor-pointer h-1 bg-gray-700 rounded-lg appearance-none"
          />
        </div>

        <div className="flex gap-3">
          <button
            onClick={onCancel}
            className="flex-1 py-3 rounded-xl bg-gray-800 text-white text-xs font-bold border border-white/5 active:scale-95 transition-all"
          >
            Cancel
          </button>
          <button
            onClick={handleCrop}
            className="flex-1 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-xs font-bold shadow-lg shadow-purple-500/20 active:scale-95 transition-all"
          >
            Crop & Apply
          </button>
        </div>
      </div>
    </div>
  );
};

const PurchaseBackupRecoveryView = ({
  goBack,
  showToast,
  db,
  auth,
  downloadBackupFiles,
  backupHistory,
  setBackupHistory
}) => {
  const [activeTab, setActiveTab] = useState("overview");
  const [stats, setStats] = useState({ totalRecords: 0, healthScore: 100, legacyCount: 0, lastBackupTime: null });
  const [loading, setLoading] = useState(true);
  const [historyList, setHistoryList] = useState([]);
  const [isCreating, setIsCreating] = useState(false);
  const [isRestoring, setIsRestoring] = useState(false);
  const [isHealing, setIsHealing] = useState(false);
  const [manualLabel, setManualLabel] = useState("");
  const [manualCategory, setManualCategory] = useState("purchase_manual");

  // JSON Import & Restore states
  const [jsonBackupData, setJsonBackupData] = useState(null);
  const [dryRunReport, setDryRunReport] = useState(null);

  // Single User Search states
  const [singleUserSearch, setSingleUserSearch] = useState("");
  const [singleUserQuerying, setSingleUserQuerying] = useState(false);
  const [singleUserResult, setSingleUserResult] = useState(null);
  const [singleUserDryRun, setSingleUserDryRun] = useState(null);

  // Golden delete confirm state
  const [goldenDeleteId, setGoldenDeleteId] = useState(null);
  const [goldenConfirmCode, setGoldenConfirmCode] = useState("");

  const fetchMetrics = async () => {
    if (!db) return;
    setLoading(true);
    try {
      // 1. Fetch live purchase records count
      const purchaseSnap = await getDocs(collection(db, "purchase_records"));
      const records = [];
      let legacyCount = 0;
      purchaseSnap.forEach(docSnap => {
        const data = docSnap.data();
        records.push(data);
        // A record is "legacy" if it's missing important fields
        if (!data.userName || !data.approvedAt || !data.paymentStatus || !data.restoreStatus || (!data.packageId && !data.courseId)) {
          legacyCount++;
        }
      });

      // Calculate health score: percentage of standardized (non-legacy) records
      const healthScore = records.length > 0 ? Math.round(((records.length - legacyCount) / records.length) * 100) : 100;

      // 2. Fetch history from backups collection
      const backupsSnap = await getDocs(collection(db, "backups"));
      const backups = [];
      backupsSnap.forEach(docSnap => {
        const data = docSnap.data();
        if (data.category && data.category.startsWith("purchase_")) {
          backups.push(data);
        }
      });
      backups.sort((a, b) => b.createdAt - a.createdAt);
      setHistoryList(backups);

      // 3. Find latest backup timestamp
      const latestBackup = backups[0];
      const lastBackupTime = latestBackup ? latestBackup.createdAt : null;

      setStats({
        totalRecords: records.length,
        healthScore,
        legacyCount,
        lastBackupTime
      });
    } catch (e) {
      console.error("Failed to fetch purchase metrics:", e);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchMetrics();
  }, [db]);

  const handleCreateBackup = async () => {
    if (isCreating) return;
    const label = manualLabel.trim() || `${manualCategory === 'purchase_golden' ? 'Golden' : 'Manual'} Purchase Backup ${new Date().toLocaleDateString()}`;

    if (manualCategory === 'purchase_golden' && !window.confirm("⚠️ Golden Backup creates a locked restore record that cannot be automatically or accidentally deleted. Proceed?")) {
      return;
    }

    setIsCreating(true);
    try {
      const adminEmail = auth.currentUser?.email || 'parwejhayat3@gmail.com';
      const snap = await createPurchaseBackupSnapshot(db, manualCategory, label, adminEmail);
      if (snap) {
        showToast(`${manualCategory === 'purchase_golden' ? 'Golden' : 'Manual'} backup created! 💾`);
        setManualLabel("");
        await fetchMetrics();
      } else {
        showToast("Failed to create backup snapshot.");
      }
    } catch (e) {
      showToast("Error: " + e.message);
    } finally {
      setIsCreating(false);
    }
  };

  const handleFileUpload = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = async (event) => {
      try {
        const parsed = JSON.parse(event.target.result);
        if (parsed.backupType !== 'purchase_records' && !parsed.purchase_records) {
          alert("Invalid backup file. This does not appear to be a purchase backup or database snapshot containing purchase records.");
          return;
        }
        setJsonBackupData(parsed);
        setDryRunReport(null);
        showToast("Backup JSON file parsed successfully! 📄");
      } catch (err) {
        alert("Invalid JSON file: " + err.message);
      }
    };
    reader.readAsText(file);
  };

  const runDryRun = async (dataPayload) => {
    if (!dataPayload) return;
    const records = dataPayload.purchase_records || [];
    let alreadyUnlocked = 0;
    let toRestore = 0;
    let missingUser = 0;
    const details = [];

    showToast("Analyzing backup records against live database... 🔍");

    for (const record of records) {
      if (!record.uid || !record.email) continue;

      const userRef = doc(db, "users", record.uid);
      const userSnap = await getDoc(userRef);

      if (!userSnap.exists()) {
        missingUser++;
        details.push({
          email: record.email,
          packageName: record.packageName,
          status: "error",
          message: "User document missing in live DB"
        });
      } else {
        const userData = userSnap.data();
        const purchased = Array.isArray(userData.purchasedPackages) ? userData.purchasedPackages : [];
        const pkgId = record.packageId || record.courseId;

        if (purchased.includes(pkgId)) {
          alreadyUnlocked++;
          details.push({
            email: record.email,
            packageName: record.packageName,
            status: "unlocked",
            message: "Already unlocked"
          });
        } else {
          toRestore++;
          details.push({
            email: record.email,
            packageName: record.packageName,
            status: "restore",
            message: "Needs unlock restoration"
          });
        }
      }
    }

    setDryRunReport({
      verified: records.length,
      alreadyUnlocked,
      toRestore,
      missingUser,
      details
    });
  };

  const executeRestore = async (recordsToRestore) => {
    if (recordsToRestore.length === 0) {
      showToast("No records need restoration!");
      return;
    }
    setIsRestoring(true);
