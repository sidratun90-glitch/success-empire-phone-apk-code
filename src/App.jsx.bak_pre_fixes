const CouponCountdown = ({ expiryTime, hasExpiry }) => {
  const [timeLeft, setTimeLeft] = useState("");
  const [isExpired, setIsExpired] = useState(false);

  useEffect(() => {
    if (!hasExpiry || !expiryTime) {
      setTimeLeft("No Expiry");
      return;
    }

    const updateTime = () => {
      const diff = expiryTime - Date.now();
      if (diff <= 0) {
        setTimeLeft("Expired");
        setIsExpired(true);
        return;
      }

      const days = Math.floor(diff / (24 * 3600 * 1000));
      const hours = Math.floor((diff % (24 * 3600 * 1000)) / (3600 * 1000));
      const minutes = Math.floor((diff % (3600 * 1000)) / (60 * 1000));
      const seconds = Math.floor((diff % (60 * 1000)) / 1000);

      let parts = [];
      if (days > 0) parts.push(`${days}d`);
      if (hours > 0 || days > 0) parts.push(`${hours}h`);
      parts.push(`${minutes}m`);
      parts.push(`${seconds}s`);
      setTimeLeft(parts.join(" "));
      setIsExpired(false);
    };

    updateTime();
    const interval = setInterval(updateTime, 1000);
    return () => clearInterval(interval);
  }, [expiryTime, hasExpiry]);

  if (!hasExpiry) return null;

  return (
    <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 w-max ${isExpired ? "bg-red-500/20 text-red-400 border border-red-500/30" : "bg-purple-500/20 text-purple-400 border border-purple-500/30 animate-pulse"}`}>
      <Clock size={10} />
      <span>{timeLeft === "Expired" ? "Expired" : `${timeLeft}`}</span>
    </span>
  );
};

