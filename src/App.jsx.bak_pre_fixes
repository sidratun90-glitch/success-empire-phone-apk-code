        if (available.length > 0) {
          const order = { '1080p': 7, '720p': 6, '540p': 5, '480p': 4, '360p': 3, '240p': 2, '144p': 1 };
          available.sort((a, b) => (order[b.toLowerCase()] || 0) - (order[a.toLowerCase()] || 0));
          const lowest = available[available.length - 1];
