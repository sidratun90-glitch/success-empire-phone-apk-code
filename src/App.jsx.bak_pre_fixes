const getWhatsAppNumber = (link) => {
  if (!link) return "917858036851";
  const match = link.match(/(?:wa\.me|api\.whatsapp\.com\/send\?phone=|chat\.whatsapp\.com\/|send\?phone=)([0-9]+)/);
  if (match && match[1]) return match[1];
  const digits = link.split('?')[0].replace(/\D/g, '');
  return digits.length >= 10 ? digits : "917858036851";
};

const copyImageToClipboard = async (imageFile) => {
  try {
    if (!imageFile || !navigator.clipboard || !window.ClipboardItem) return false;

    if (imageFile.type === 'image/png') {
      await navigator.clipboard.write([
        new ClipboardItem({ 'image/png': imageFile })
      ]);
      return true;
    }

    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) {
          resolve(false);
          return;
        }
        ctx.drawImage(img, 0, 0);
        canvas.toBlob(async (blob) => {
          if (blob) {
            try {
              await navigator.clipboard.write([
                new ClipboardItem({ 'image/png': blob })
              ]);
              resolve(true);
            } catch (err) {
              console.warn("Clipboard write failed:", err);
              resolve(false);
            }
          } else {
            resolve(false);
          }
        }, 'image/png');
      };
      img.onerror = () => resolve(false);
      img.src = URL.createObjectURL(imageFile);
    });
  } catch (err) {
    console.warn("Failed to copy image to clipboard:", err);
    return false;
  }
};

